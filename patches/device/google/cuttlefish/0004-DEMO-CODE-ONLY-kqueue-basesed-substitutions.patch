   char event_readout[INOTIFY_MAX_EVENT_SIZE];
   int bytes_parsed = 0;
   std::vector<std::string> result;
@@ -68,6 +128,45 @@ std::vector<std::string> GetFileListFromInotifyFd(int fd, uint32_t mask) {
   }
 
   return result;
+#elif defined(__APPLE__)
+std::vector<std::string> result;
+  
+  // Use kqueue to read events
+  struct kevent events[10];
+  struct timespec timeout = {0, 0}; // Non-blocking
+  
+  int num_events = kevent(fd, nullptr, 0, events, 10, &timeout);
+  if (num_events == -1) {
+    LOG(ERROR) << __FUNCTION__
+               << ": Couldn't read out kqueue event due to error: '"
+               << strerror(errno) << "' (" << errno << ")";
+    return result;
+  }
+  
+  for (int i = 0; i < num_events; i++) {
+    struct kevent& event = events[i];
+    
+    // Convert kqueue filter flags to inotify mask
+    uint32_t event_mask = KqueueFilterToInotifyMask(event.fflags);
+    
+    if (!(event_mask & mask)) {
+      continue; // Event doesn't match requested mask
+    }
+    
+    // For kqueue, we don't get the filename directly in the event
+    // This is a limitation of the kqueue-based implementation
+    // In a full implementation, we'd need to track filenames separately
+    // For now, we'll return a placeholder indicating an event occurred
+    result.push_back("kqueue_event_detected");
+  }
+  
+  return result;
+#else
+  (void)fd;
+  (void)mask;
+  LOG(ERROR) << __FUNCTION__ << ": inotify not supported on this platform";
+  return std::vector<std::string>();
+#endif
 }
 
 }  // namespace cuttlefish
