--- a/common/libs/utils/subprocess.cpp
+++ b/common/libs/utils/subprocess.cpp
@@ -18,6 +18,9 @@
 
 #ifdef __linux__
 #include <sys/prctl.h>
+#elif defined(__APPLE__)
+#include <sys/event.h>
+#include <sys/time.h>
 #endif
 
 #include <errno.h>
@@ -130,7 +133,7 @@ SubprocessOptions SubprocessOptions::Verbose(bool verbose) && {
   return std::move(*this);
 }
 
-#ifdef __linux__
+#if defined(__linux__) || defined(__APPLE__)
 SubprocessOptions& SubprocessOptions::ExitWithParent(bool v) & {
   exit_with_parent_ = v;
   return *this;
@@ -431,6 +434,53 @@ Subprocess Command::Start(SubprocessOptions options) const {
     if (options.ExitWithParent()) {
       prctl(PR_SET_PDEATHSIG, SIGHUP); // Die when parent dies
     }
+// MacOS variation of ExitWithParent
+#elif defined(__APPLE__)
+    if (options.ExitWithParent()) {
+      // macOS doesn't have prctl(PR_SET_PDEATHSIG), so we implement
+      // exit-with-parent using kqueue to monitor the parent process
+      pid_t parent_pid = getppid();
+      
+      // Create a kqueue to monitor parent process
+      int kq = kqueue();
+      if (kq != -1) {
+        struct kevent kev;
+        // Monitor parent process for exit
+        EV_SET(&kev, parent_pid, EVFILT_PROC, EV_ADD | EV_ONESHOT, NOTE_EXIT, 0, NULL);
+        
+        if (kevent(kq, &kev, 1, NULL, 0, NULL) == 0) {
+          // Fork a monitoring process to watch for parent exit
+          pid_t monitor_pid = fork();
+          if (monitor_pid == 0) {
+            // Monitor child process - wait for parent to exit
+            struct kevent event;
+            int nev = kevent(kq, NULL, 0, &event, 1, NULL);
+            close(kq);
+            if (nev > 0 && event.filter == EVFILT_PROC && event.fflags & NOTE_EXIT) {
+              // Parent exited, kill the main child process
+              kill(getppid(), SIGTERM);
+            }
+            _exit(0);
+          } else if (monitor_pid > 0) {
+            // Main child process continues normally
+            close(kq);
+          } else {
+            // Fork failed, fall back to simple polling
+            close(kq);
+            pid_t simple_monitor = fork();
+            if (simple_monitor == 0) {
+              while (kill(parent_pid, 0) == 0) {
+                usleep(500000); // Check every 500ms
+              }
+              kill(getppid(), SIGTERM);
+              _exit(0);
+            }
+          }
+        } else {
+          close(kq);
+        }
+      }
+    }
 #endif
 
     do_redirects(redirects_);
