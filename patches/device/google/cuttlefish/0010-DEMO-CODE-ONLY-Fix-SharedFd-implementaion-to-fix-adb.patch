                    << watched.size();
       } else {
         LOG(ERROR) << "Cannot connect to the target to setup proxying: " << target->StrError();
+        client->Close(); // <=== Why?
       }
       // Unwatch completed proxy pairs
       watched.remove_if([](ProxyPair& proxy) { return !proxy.Running(); });
