diff --git a/common/libs/fs/shared_fd.cpp b/common/libs/fs/shared_fd.cpp
index 2fff8cc43..e8acf236e 100644
--- a/common/libs/fs/shared_fd.cpp
+++ b/common/libs/fs/shared_fd.cpp
@@ -266,7 +266,23 @@ void FileInstance::Close() {
   std::stringstream message;
   if (fd_ == -1) {
     errno_ = EBADF;
-  } else if (close(fd_) == -1) {
+  } else {
+#ifdef __APPLE__
+    // Clean up eventfd emulation resources if this is an eventfd
+    static std::mutex eventfd_map_mutex;
+    static std::unordered_map<int, int> eventfd_write_fds;
+    {
+      std::lock_guard<std::mutex> lock(eventfd_map_mutex);
+      auto it = eventfd_write_fds.find(fd_);
+      if (it != eventfd_write_fds.end()) {
+        // Close the write end of the pipe
+        close(it->second);
+        // Remove from the map
+        eventfd_write_fds.erase(it);
+      }
+    }
+#endif
+      if (close(fd_) == -1) {
     errno_ = errno;
     if (identity_.size()) {
       message << __FUNCTION__ << ": " << identity_ << " failed (" << StrError() << ")";
@@ -279,6 +295,7 @@ void FileInstance::Close() {
       std::string message_str = message.str();
       Log(message_str.c_str());
     }
+    }
   }
   fd_ = -1;
 }
@@ -522,12 +539,15 @@ SharedFD SharedFD::Event(int initval, int flags) {
     write(pipe_fds[1], &val, sizeof(val));
   }
   
-  // For eventfd emulation, we need to store both read and write ends
-  // We'll return the read end as the main fd, and store the write end
-  // This is a simplified implementation - a full implementation would
-  // need a custom FileInstance subclass to handle both ends properly
-  close(pipe_fds[1]); // For now, close write end
-  
+  // Store the write end in a global map so EventfdWrite can access it
+  // This is a workaround since FileInstance only stores one fd
+  static std::mutex eventfd_map_mutex;
+  static std::unordered_map<int, int> eventfd_write_fds;
+
+  {
+    std::lock_guard<std::mutex> lock(eventfd_map_mutex);
+    eventfd_write_fds[pipe_fds[0]] = pipe_fds[1];
+  }
   return std::shared_ptr<FileInstance>(new FileInstance(pipe_fds[0], 0));
 #endif
 }
@@ -1182,8 +1202,20 @@ int FileInstance::EventfdWrite(eventfd_t value) {
   return eventfd_write(fd_, value);
 #elif defined(__APPLE__)
   // macOS doesn't have eventfd_write, so we emulate it using write()
+  static std::mutex eventfd_map_mutex;
+  static std::unordered_map<int, int> eventfd_write_fds;
+  int write_fd;
+  {
+    std::lock_guard<std::mutex> lock(eventfd_map_mutex);
+    auto it = eventfd_write_fds.find(fd_);
+    if (it == eventfd_write_fds.end()) {
+      errno_ = EBADF;
+      return -1;
+    }
+    write_fd = it->second;
+  }
   // eventfd_t is typically uint64_t, so we write the value directly
-  ssize_t result = write(fd_, &value, sizeof(value));
+  ssize_t result = write(write_fd, &value, sizeof(value));  
   if (result == sizeof(value)) {
     return 0;  // Success
   } else {
