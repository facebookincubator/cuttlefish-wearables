+/* Copyright (c) 2026 Meta Platforms Inc. All rights reserved. */
+
+#include "host/libs/config/instance_registry.h"
+
+#include <errno.h>
+#include <signal.h>
+#include <sys/file.h>
+#include <unistd.h>
+
+#include <fstream>
+#include <set>
+#include <sstream>
+#include <string>
+#include <vector>
+
+#include <android-base/logging.h>
+#include <json/json.h>
+
+#include "common/libs/utils/environment.h"
+#include "common/libs/utils/files.h"
+#include "common/libs/utils/result.h"
+
+namespace cuttlefish {
+namespace {
+
+static constexpr char kInstances[] = "instances";
+static constexpr char kConfigPath[] = "config_path";
+static constexpr char kRunCvdPid[] = "run_cvd_pid";
+static constexpr char kStatus[] = "status";
+static constexpr char kStatusRunning[] = "running";
+
+// RAII wrapper for file-based locking via flock().
+class FileLock {
+ public:
+  static Result<FileLock> Acquire(const std::string& path) {
+    int fd = open(path.c_str(), O_RDWR | O_CREAT, 0600);
+    CF_EXPECT(fd >= 0, "Failed to open registry file: " << path);
+    int ret = flock(fd, LOCK_EX);
+    if (ret != 0) {
+      close(fd);
+      return CF_ERR("Failed to lock registry file: " << strerror(errno));
+    }
+    return FileLock(fd);
+  }
+
+  ~FileLock() {
+    if (fd_ >= 0) {
+      flock(fd_, LOCK_UN);
+      close(fd_);
+    }
+  }
+
+  FileLock(FileLock&& other) : fd_(other.fd_) { other.fd_ = -1; }
+  FileLock& operator=(FileLock&& other) {
+    if (this != &other) {
+      if (fd_ >= 0) {
+        flock(fd_, LOCK_UN);
+        close(fd_);
+      }
+      fd_ = other.fd_;
+      other.fd_ = -1;
+    }
+    return *this;
+  }
+
+  FileLock(const FileLock&) = delete;
+  FileLock& operator=(const FileLock&) = delete;
+
+ private:
+  explicit FileLock(int fd) : fd_(fd) {}
+  int fd_;
+};
+
+bool IsProcessAlive(pid_t pid) {
+  if (pid <= 0) return false;
+  return kill(pid, 0) == 0;
+}
+
+Result<Json::Value> ReadRegistry(const std::string& path) {
+  Json::Value root;
+  if (!FileExists(path)) {
+    root[kInstances] = Json::Value(Json::objectValue);
+    return root;
+  }
+  Json::CharReaderBuilder builder;
+  std::ifstream ifs(path);
+  std::string errors;
+  if (!Json::parseFromStream(builder, ifs, &root, &errors)) {
+    LOG(WARNING) << "Failed to parse registry file, starting fresh: " << errors;
+    root = Json::Value();
+    root[kInstances] = Json::Value(Json::objectValue);
+  }
+  if (!root.isMember(kInstances)) {
+    root[kInstances] = Json::Value(Json::objectValue);
+  }
+  return root;
+}
+
+Result<void> WriteRegistry(const std::string& path, const Json::Value& root) {
+  // Atomic write: write to temp file then rename
+  auto tmp_path = path + ".tmp";
+  {
+    std::ofstream ofs(tmp_path);
+    CF_EXPECT(ofs.is_open(), "Failed to open temp registry file: " << tmp_path);
+    Json::StreamWriterBuilder writer;
+    writer["indentation"] = "  ";
+    ofs << Json::writeString(writer, root);
+    CF_EXPECT(!ofs.fail(), "Failed to write temp registry file");
+  }
+  CF_EXPECT(rename(tmp_path.c_str(), path.c_str()) == 0,
+            "Failed to rename temp registry file: " << strerror(errno));
+  return {};
+}
+
+}  // namespace
+
+std::string GetRegistryFilePath() {
+  // Use a global per-user path in /tmp so that all emulator instances (which
+  // each have HOME set to their own directory) share a single registry.
+  // This lets ClaimNextFreeInstance() assign globally-unique instance numbers
+  // for port/CID allocation, while each emulator's directory is always cvd-1
+  // (local to its own HOME) via display_name.
+  return "/tmp/cuttlefish_instances_" + std::to_string(getuid()) + ".json";
+}
+
+Result<void> RegisterInstance(int instance_num,
+                              const std::string& config_path,
+                              pid_t run_cvd_pid) {
+  auto registry_path = GetRegistryFilePath();
+  auto lock = CF_EXPECT(FileLock::Acquire(registry_path));
+  auto root = CF_EXPECT(ReadRegistry(registry_path));
+
+  auto key = std::to_string(instance_num);
+  Json::Value entry;
+  entry[kConfigPath] = config_path;
+  entry[kRunCvdPid] = static_cast<int>(run_cvd_pid);
+  entry[kStatus] = kStatusRunning;
+  root[kInstances][key] = entry;
+
+  CF_EXPECT(WriteRegistry(registry_path, root));
+  return {};
+}
+
+Result<void> UnregisterInstance(int instance_num) {
+  auto registry_path = GetRegistryFilePath();
+  auto lock = CF_EXPECT(FileLock::Acquire(registry_path));
+  auto root = CF_EXPECT(ReadRegistry(registry_path));
+
+  auto key = std::to_string(instance_num);
+  root[kInstances].removeMember(key);
+
+  CF_EXPECT(WriteRegistry(registry_path, root));
+  return {};
+}
+
+Result<std::optional<InstanceRegistryEntry>> LookupInstance(int instance_num) {
+  auto registry_path = GetRegistryFilePath();
+  auto lock = CF_EXPECT(FileLock::Acquire(registry_path));
+  auto root = CF_EXPECT(ReadRegistry(registry_path));
+
+  auto key = std::to_string(instance_num);
+  if (!root[kInstances].isMember(key)) {
+    return std::nullopt;
+  }
+
+  const auto& entry = root[kInstances][key];
+  InstanceRegistryEntry result;
+  result.instance_num = instance_num;
+  result.config_path = entry[kConfigPath].asString();
+  result.run_cvd_pid = static_cast<pid_t>(entry[kRunCvdPid].asInt());
+  result.status = entry[kStatus].asString();
+  return result;
+}
+
+Result<std::vector<InstanceRegistryEntry>> ListInstances() {
+  auto registry_path = GetRegistryFilePath();
+  auto lock = CF_EXPECT(FileLock::Acquire(registry_path));
+  auto root = CF_EXPECT(ReadRegistry(registry_path));
+
+  std::vector<InstanceRegistryEntry> result;
+  bool cleaned = false;
+  auto& instances = root[kInstances];
+  std::vector<std::string> to_remove;
+
+  for (const auto& key : instances.getMemberNames()) {
+    const auto& entry = instances[key];
+    pid_t pid = static_cast<pid_t>(entry[kRunCvdPid].asInt());
+    // Clean up stale entries (dead PIDs)
+    if (!IsProcessAlive(pid)) {
+      to_remove.push_back(key);
+      cleaned = true;
+      continue;
+    }
+    InstanceRegistryEntry e;
+    e.instance_num = std::stoi(key);
+    e.config_path = entry[kConfigPath].asString();
+    e.run_cvd_pid = pid;
+    e.status = entry[kStatus].asString();
+    result.push_back(e);
+  }
+
+  for (const auto& key : to_remove) {
+    instances.removeMember(key);
+  }
+
+  if (cleaned) {
+    CF_EXPECT(WriteRegistry(registry_path, root));
+  }
+
+  return result;
+}
+
+Result<int> ClaimNextFreeInstance(int start) {
+  auto registry_path = GetRegistryFilePath();
+  auto lock = CF_EXPECT(FileLock::Acquire(registry_path));
+  auto root = CF_EXPECT(ReadRegistry(registry_path));
+
+  // Clean stale entries and collect occupied instance numbers.
+  // Also check if we already claimed an instance (Calculate() is called
+  // multiple times within a single assemble_cvd process).
+  auto& instances = root[kInstances];
+  std::set<int> occupied;
+  std::vector<std::string> to_remove;
+  auto my_pid = getpid();
+  auto parent_pid = getppid();
+  for (const auto& key : instances.getMemberNames()) {
+    pid_t pid = static_cast<pid_t>(instances[key][kRunCvdPid].asInt());
+    if (!IsProcessAlive(pid)) {
+      to_remove.push_back(key);
+    } else {
+      int key_num = std::stoi(key);
+      if ((pid == my_pid || pid == parent_pid) && key_num >= start) {
+        // We (or our parent launch_cvd) already claimed this slot.
+        // Return it instead of claiming a new one.
+        // Only match slots >= start so that a process claiming multiple
+        // instances doesn't keep returning the first one.
+        for (const auto& rm_key : to_remove) {
+          instances.removeMember(rm_key);
+        }
+        if (!to_remove.empty()) {
+          CF_EXPECT(WriteRegistry(registry_path, root));
+        }
+        return key_num;
+      }
+      occupied.insert(std::stoi(key));
+    }
+  }
+  for (const auto& key : to_remove) {
+    instances.removeMember(key);
+  }
+
+  // Find the lowest free instance number.
+  int candidate = start;
+  while (occupied.count(candidate)) {
+    candidate++;
+  }
+
+  // Register a placeholder so concurrent launchers see this slot as taken.
+  auto key = std::to_string(candidate);
+  Json::Value entry;
+  entry[kConfigPath] = "";
+  entry[kRunCvdPid] = static_cast<int>(my_pid);
+  entry[kStatus] = kStatusRunning;
+  root[kInstances][key] = entry;
+
+  CF_EXPECT(WriteRegistry(registry_path, root));
+  return candidate;
+}
+
+Result<bool> IsInstanceRunning(int instance_num) {
+  auto entry = CF_EXPECT(LookupInstance(instance_num));
+  if (!entry.has_value()) {
+    return false;
+  }
+  return IsProcessAlive(entry->run_cvd_pid);
+}
+
+Result<std::string> GetInstanceConfigPath(int instance_num) {
+  auto entry = CF_EXPECT(LookupInstance(instance_num));
+  if (!entry.has_value()) {
+    return "";
+  }
+  return entry->config_path;
+}
+
+}  // namespace cuttlefish
