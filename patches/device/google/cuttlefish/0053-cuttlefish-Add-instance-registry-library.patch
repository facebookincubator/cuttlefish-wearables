+/* Copyright (c) 2026 Meta Platforms Inc. All rights reserved. */
+
+#pragma once
+
+#include <string>
+#include <vector>
+
+#include "common/libs/utils/result.h"
+
+namespace cuttlefish {
+
+// Tracks independently-launched Cuttlefish instances so that multiple
+// launch_cvd invocations can coexist without a monolithic config file.
+//
+// Registry file: /tmp/cuttlefish_instances_<uid>.json (global, shared across HOMEs)
+// Format:
+//   {
+//     "instances": {
+//       "1": { "config_path": "...", "run_cvd_pid": 12345, "status": "running" },
+//       "3": { "config_path": "...", "run_cvd_pid": 12350, "status": "running" }
+//     }
+//   }
+//
+// Concurrent access is protected by flock() on the registry file.
+// Writes are atomic (write-to-temp + rename).
+
+struct InstanceRegistryEntry {
+  int instance_num;
+  std::string config_path;
+  pid_t run_cvd_pid;
+  std::string status;  // "running" or "stopped"
+};
+
+// Returns the path to the registry file (~/.cuttlefish_instances.json).
+std::string GetRegistryFilePath();
+
+// Register an instance in the registry. Creates the file if it doesn't exist.
+Result<void> RegisterInstance(int instance_num,
+                              const std::string& config_path,
+                              pid_t run_cvd_pid);
+
+// Remove an instance from the registry.
+Result<void> UnregisterInstance(int instance_num);
+
+// Look up a single instance. Returns empty if not found.
+Result<std::optional<InstanceRegistryEntry>> LookupInstance(int instance_num);
+
+// List all registered instances, cleaning up stale entries (dead PIDs).
+Result<std::vector<InstanceRegistryEntry>> ListInstances();
+
+// Atomically find the lowest free instance number starting from `start`,
+// register a placeholder for it, and return the claimed number.
+// Used by InstanceNumsCalculator to prevent races between concurrent launches.
+Result<int> ClaimNextFreeInstance(int start);
+
+// Check if an instance is currently running (registered and PID alive).
+Result<bool> IsInstanceRunning(int instance_num);
+
+// Get the config path for a specific instance from the registry.
+// Returns empty string if not found.
+Result<std::string> GetInstanceConfigPath(int instance_num);
+
+}  // namespace cuttlefish
