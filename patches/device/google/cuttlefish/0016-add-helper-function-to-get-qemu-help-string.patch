 host/libs/vm_manager/qemu_manager.cpp | 18 ++++++++++++++++++
 1 file changed, 18 insertions(+)

diff --git a/host/libs/vm_manager/qemu_manager.cpp b/host/libs/vm_manager/qemu_manager.cpp
index 6260d03b7..70b5a3e96 100644
--- a/host/libs/vm_manager/qemu_manager.cpp
+++ b/host/libs/vm_manager/qemu_manager.cpp
@@ -86,6 +86,24 @@ StopperResult Stop() {
   return StopperResult::kStopSuccess;
 }
 
+Result<std::string> GetQemuHelpString(const std::string& qemu_binary) {
+  Command qemu_help_cmd(qemu_binary);
+  qemu_help_cmd.AddParameter("-help");
+
+  std::string qemu_help_input, qemu_help_output, qemu_help_error;
+  cuttlefish::SubprocessOptions options;
+  options.Verbose(false);
+  int qemu_help_ret = cuttlefish::RunWithManagedStdio(
+      std::move(qemu_help_cmd), &qemu_help_input, &qemu_help_output,
+      &qemu_help_error, std::move(options));
+  CF_EXPECT(qemu_help_ret == 0,
+            qemu_binary << " -help returned unexpected response "
+                        << qemu_help_output << ". Stderr was "
+                        << qemu_help_error);
+
+  return qemu_help_output;
+}
