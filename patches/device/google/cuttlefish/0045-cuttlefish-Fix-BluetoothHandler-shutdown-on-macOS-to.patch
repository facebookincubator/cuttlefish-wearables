From 98a5fc0ce49f7adfb13b1973f6a843ee52f3b23e Mon Sep 17 00:00:00 2001
From: Alex Chong <achong@meta.com>
Date: Thu, 19 Mar 2026 14:43:47 -0700
Subject: [PATCH 45/63] [cuttlefish] Fix BluetoothHandler shutdown on macOS to
 prevent thread leak
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Summary:
# Motivation:

Same bug as adbhandler. Refreshing webrtc page will eventually freeze and fail to reconnect.

# Overview:
- use EventfdWrite() which looks up the pipe's write end from an internal map. This is backwards compatible — on Linux, EventfdWrite() calls the native eventfd_write() which works identically.
---
 host/frontend/webrtc/bluetooth_handler.cpp | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/host/frontend/webrtc/bluetooth_handler.cpp b/host/frontend/webrtc/bluetooth_handler.cpp
index be5710bda..da062761f 100644
--- a/host/frontend/webrtc/bluetooth_handler.cpp
+++ b/host/frontend/webrtc/bluetooth_handler.cpp
@@ -37,9 +37,10 @@ BluetoothHandler::BluetoothHandler(
 }
 
 BluetoothHandler::~BluetoothHandler() {
-  // Send a message to the looper to shut down.
-  uint64_t v = 1;
-  shutdown_->Write(&v, sizeof(v));
+  // Signal the ReadLoop to exit. Must use EventfdWrite (not Write) because
+  // on macOS, Event() is emulated with a pipe and the SharedFD wraps the
+  // read end — Write() to the read end silently fails.
+  shutdown_->EventfdWrite(1);
   // Shut down the socket as well.  Not strictly necessary.
   rootcanal_socket_->Shutdown(SHUT_RDWR);
   read_thread_.join();
