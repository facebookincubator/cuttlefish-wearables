+Result<void> ProcessMonitor::WaitForMonitorExit() {
+  if (monitor_ == -1) {
+    return {};
+  }
+  pid_t last_monitor = monitor_;
+  monitor_ = -1;
+  parent_channel_.reset();
+  int wstatus;
+  CF_EXPECT(waitpid(last_monitor, &wstatus, 0) == last_monitor,
+            "Failed to wait for monitor process");
+  return {};
+}
