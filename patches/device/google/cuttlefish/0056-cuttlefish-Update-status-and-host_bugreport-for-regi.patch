diff --git a/host/commands/host_bugreport/main.cc b/host/commands/host_bugreport/main.cc
index b4dcb4dcc..b9a1011f9 100644
--- a/host/commands/host_bugreport/main.cc
+++ b/host/commands/host_bugreport/main.cc
@@ -31,6 +31,7 @@
 #include "common/libs/utils/subprocess.h"
 #include "common/libs/utils/tee_logging.h"
 #include "host/libs/config/cuttlefish_config.h"
+#include "host/libs/config/instance_registry.h"
 #include "ziparchive/zip_writer.h"
 
 DEFINE_string(output, "host_bugreport.zip", "Where to write the output");
@@ -128,19 +129,49 @@ Result<void> CvdHostBugreportMain(int argc, char** argv) {
   }
 
   auto config = CuttlefishConfig::Get();
+
+  // If no monolithic config, try to enumerate instances from the registry.
+  std::vector<std::unique_ptr<const CuttlefishConfig>> registry_configs;
+  if (!config) {
+    auto instances = ListInstances();
+    if (instances.ok() && !instances->empty()) {
+      for (const auto& entry : *instances) {
+        auto inst_config =
+            CuttlefishConfig::GetForInstance(entry.instance_num);
+        if (inst_config) {
+          registry_configs.push_back(std::move(inst_config));
+        }
+      }
+      if (!registry_configs.empty()) {
+        config = registry_configs[0].get();
+      }
+    }
+  }
   CHECK(config) << "Unable to find the config";
 
   auto out_path = FLAGS_output.c_str();
   std::unique_ptr<FILE, decltype(&fclose)> out(fopen(out_path, "wbe"), &fclose);
   ZipWriter writer(out.get());
 
-  auto save = [&writer, config](const std::string& path) {
+  auto save_assembly = [&writer, config](const std::string& path) {
     SaveFile(writer, "cuttlefish_assembly/" + path, config->AssemblyPath(path));
   };
-  save("assemble_cvd.log");
-  save("cuttlefish_config.json");
+  save_assembly("assemble_cvd.log");
+  save_assembly("cuttlefish_config.json");
 
-  for (const auto& instance : config->Instances()) {
+  // Collect all configs to iterate: either the single monolithic config
+  // or multiple configs from the registry.
+  std::vector<const CuttlefishConfig*> all_configs;
+  if (!registry_configs.empty()) {
+    for (const auto& rc : registry_configs) {
+      all_configs.push_back(rc.get());
+    }
+  } else {
+    all_configs.push_back(config);
+  }
+
+  for (const auto* cfg : all_configs) {
+    for (const auto& instance : cfg->Instances()) {
     auto save = [&writer, instance](const std::string& path) {
       const auto& zip_name = instance.instance_name() + "/" + path;
       const auto& file_name = instance.PerInstancePath(path.c_str());
@@ -212,7 +243,8 @@ Result<void> CvdHostBugreportMain(int argc, char** argv) {
       }
       static_cast<void>(RecursivelyRemoveDirectory(device_br_dir));
     }
-  }
+  }  // for each instance
+  }  // for each config
 
   AddNetsimdLogs(writer);
 
