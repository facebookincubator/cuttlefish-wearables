@@ -111,8 +118,68 @@ Json::Value PopulateDevicesInfoFromInstance(
 }
 
 Result<void> CvdStatusMain(const StatusFlags& flag_values) {
-  const CuttlefishConfig* config =
-      CF_EXPECT(CuttlefishConfig::Get(), "Failed to obtain config object");
+  // If a specific instance number was requested, load its config
+  // from the instance registry (independent instance mode).
+  if (flag_values.instance_num > 0) {
+    auto inst_config =
+        CuttlefishConfig::GetForInstance(flag_values.instance_num);
+    CF_EXPECT(inst_config != nullptr,
+              "Could not load config for instance "
+                  << flag_values.instance_num << " from registry");
+    Json::Value devices_info;
+    int index = 0;
+    for (const auto& instance : inst_config->Instances()) {
+      SharedFD monitor_socket = CF_EXPECT(GetLauncherMonitorFromInstance(
+          instance, flag_values.wait_for_launcher));
+      CF_EXPECT(RunLauncherAction(monitor_socket, LauncherAction::kStatus,
+                                  flag_values.wait_for_launcher));
+      devices_info[index] =
+          PopulateDevicesInfoFromInstance(*inst_config, instance);
+      LOG(INFO) << "run_cvd is active for instance "
+                << instance.instance_name();
+      index++;
+    }
+    if (flag_values.print) {
+      std::cout << devices_info.toStyledString();
+    }
+    return {};
+  }
+
+  const CuttlefishConfig* config = CuttlefishConfig::Get();
+
+  // If no monolithic config and --all_instances, try the registry.
+  if (!config && flag_values.all_instances) {
+    auto instances = ListInstances();
+    if (instances.ok() && !instances->empty()) {
+      Json::Value devices_info;
+      int index = 0;
+      for (const auto& entry : *instances) {
+        auto inst_config = CuttlefishConfig::GetForInstance(entry.instance_num);
+        if (!inst_config) {
+          LOG(ERROR) << "Could not load config for instance "
+                     << entry.instance_num;
+          continue;
+        }
+        for (const auto& instance : inst_config->Instances()) {
+          SharedFD monitor_socket = CF_EXPECT(GetLauncherMonitorFromInstance(
+              instance, flag_values.wait_for_launcher));
+          CF_EXPECT(RunLauncherAction(monitor_socket, LauncherAction::kStatus,
+                                      flag_values.wait_for_launcher));
+          devices_info[index] =
+              PopulateDevicesInfoFromInstance(*inst_config, instance);
+          LOG(INFO) << "run_cvd is active for instance "
+                    << instance.instance_name();
+          index++;
+        }
+      }
+      if (flag_values.print) {
+        std::cout << devices_info.toStyledString();
+      }
+      return {};
+    }
+  }
+
+  CF_EXPECT(config != nullptr, "Failed to obtain config object");
 
