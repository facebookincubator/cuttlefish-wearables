 // inotify related functions
 int FileInstance::InotifyAddWatch(const std::string& pathname, uint32_t mask) {
+  #ifdef __linux__
+  LocalErrno record_errno(errno_);
   return inotify_add_watch(fd_, pathname.c_str(), mask);
+#elif defined(__APPLE__)
+  LocalErrno record_errno(errno_);
+  
+  // Open the file to get a file descriptor for kqueue
+  int watch_fd = open(pathname.c_str(), O_RDONLY);
+  if (watch_fd == -1) {
+    return -1;
+  }
+  
+  // Convert inotify mask to kqueue filter flags
+  uint32_t kqueue_flags = InotifyMaskToKqueueFilter(mask);
+  
+  // Create kevent structure
+  struct kevent kev;
+  EV_SET(&kev, watch_fd, EVFILT_VNODE, EV_ADD | EV_CLEAR, kqueue_flags, 0, nullptr);
+  
+  // Add the event to the kqueue
+  if (kevent(fd_, &kev, 1, nullptr, 0, nullptr) == -1) {
+    close(watch_fd);
+    return -1;
+  }
+  // Track this watch
+  std::lock_guard<std::mutex> lock(kqueue_mutex);
+  int watch_id = next_watch_id++;
+  kqueue_watches[fd_][watch_id] = {watch_fd, pathname, mask};
+  
+  return watch_id;
+#else
+  (void)pathname;
+  (void)mask;
+  errno_ = ENOSYS;
+  return -1;
+#endif
 }
 
 void FileInstance::InotifyRmWatch(int watch) {
+  #ifdef __linux__
+  LocalErrno record_errno(errno_);
   inotify_rm_watch(fd_, watch);
+#elif defined(__APPLE__)
+  LocalErrno record_errno(errno_);
+  
+  std::lock_guard<std::mutex> lock(kqueue_mutex);
+  auto kqueue_it = kqueue_watches.find(fd_);
+  if (kqueue_it == kqueue_watches.end()) {
+    errno_ = EINVAL;
+    return;
+  }
+  
+  auto watch_it = kqueue_it->second.find(watch);
+  if (watch_it == kqueue_it->second.end()) {
+    errno_ = EINVAL;
+    return;
+  }
+  // Remove the event from kqueue
+  struct kevent kev;
+  EV_SET(&kev, watch_it->second.watch_fd, EVFILT_VNODE, EV_DELETE, 0, 0, nullptr);
+  kevent(fd_, &kev, 1, nullptr, 0, nullptr);
+  
+  // Close the watched file descriptor
+  close(watch_it->second.watch_fd);
+  
+  // Remove from tracking
+  kqueue_it->second.erase(watch_it);
+  if (kqueue_it->second.empty()) {
+    kqueue_watches.erase(kqueue_it);
+  }
+#else
+  (void)watch;
+  errno_ = ENOSYS;
+#endif
 }
 
