-#ifdef __linux__
+#if defined(__linux__) || defined(__APPLE__)
 SharedFD SharedFD::Event(int initval, int flags) {
+#ifdef __linux__
   int fd = eventfd(initval, flags);
   return std::shared_ptr<FileInstance>(new FileInstance(fd, errno));
+#elif defined(__APPLE__)
+  // macOS doesn't have eventfd, so we use a pipe-based implementation
+  int pipe_fds[2];
+  if (pipe(pipe_fds) == -1) {
+    return std::shared_ptr<FileInstance>(new FileInstance(-1, errno));
+  }
+  
+  // Set non-blocking if EFD_NONBLOCK is requested
+  if (flags & 0x800) { // EFD_NONBLOCK value
+    fcntl(pipe_fds[0], F_SETFL, O_NONBLOCK);
+    fcntl(pipe_fds[1], F_SETFL, O_NONBLOCK);
+  }
+  
+  // Set close-on-exec if EFD_CLOEXEC is requested
+  if (flags & 0x80000) { // EFD_CLOEXEC value
+    fcntl(pipe_fds[0], F_SETFD, FD_CLOEXEC);
+    fcntl(pipe_fds[1], F_SETFD, FD_CLOEXEC);
+  }
+  
+  // Write initial value if non-zero
+  if (initval > 0) {
+    uint64_t val = initval;
+    write(pipe_fds[1], &val, sizeof(val));
+  }
+  
+  // For eventfd emulation, we need to store both read and write ends
+  // We'll return the read end as the main fd, and store the write end
+  // This is a simplified implementation - a full implementation would
+  // need a custom FileInstance subclass to handle both ends properly
+  close(pipe_fds[1]); // For now, close write end
+  
+  return std::shared_ptr<FileInstance>(new FileInstance(pipe_fds[0], 0));
+#endif
 }
 
