+// macOS kqueue-based inotify replacement
+namespace {
+struct KqueueWatch {
+  int watch_fd;  // File descriptor being watched
+  std::string path;  // Path being watched
+  uint32_t mask;  // inotify mask
+};
+
+// Global state for kqueue-based inotify replacement
+static std::mutex kqueue_mutex;
+static std::unordered_map<int, std::unordered_map<int, KqueueWatch>> kqueue_watches; // kqueue_fd -> watch_id -> KqueueWatch
+static int next_watch_id = 1;
+
+// Define kqueue note constants if not available
+#ifndef NOTE_DELETE
+#define NOTE_DELETE 0x00000001
+#endif
+#ifndef NOTE_WRITE
+#define NOTE_WRITE 0x00000002
+#endif
+#ifndef NOTE_EXTEND
+#define NOTE_EXTEND 0x00000004
+#endif
+#ifndef NOTE_ATTRIB
+#define NOTE_ATTRIB 0x00000008
+#endif
+#ifndef NOTE_LINK
+#define NOTE_LINK 0x00000010
+#endif
+#ifndef NOTE_RENAME
+#define NOTE_RENAME 0x00000020
+#endif
+#ifndef NOTE_REVOKE
+#define NOTE_REVOKE 0x00000040
+#endif
+
+// Convert inotify mask to kqueue filter flags
+uint32_t InotifyMaskToKqueueFilter(uint32_t inotify_mask) {
+  uint32_t kqueue_flags = 0;
+  
+  // Map common inotify events to kqueue events
+  if (inotify_mask & 0x00000001) { // IN_ACCESS
+    kqueue_flags |= NOTE_EXTEND; // Use NOTE_EXTEND for access-like events
+  }
+  if (inotify_mask & 0x00000002) { // IN_MODIFY
+    kqueue_flags |= NOTE_WRITE;
+  }
+  if (inotify_mask & 0x00000004) { // IN_ATTRIB
+    kqueue_flags |= NOTE_ATTRIB;
+  }
+  if (inotify_mask & 0x00000008) { // IN_CLOSE_WRITE
+    kqueue_flags |= NOTE_WRITE;
+  }
+  if (inotify_mask & 0x00000010) { // IN_CLOSE_NOWRITE
+    kqueue_flags |= NOTE_EXTEND;
+  }
+  if (inotify_mask & 0x00000020) { // IN_OPEN
+    kqueue_flags |= NOTE_EXTEND;
+  }
+  if (inotify_mask & 0x00000040) { // IN_MOVED_FROM
+    kqueue_flags |= NOTE_RENAME;
+  }
+  if (inotify_mask & 0x00000080) { // IN_MOVED_TO
+    kqueue_flags |= NOTE_RENAME;
+  }
+  if (inotify_mask & 0x00000100) { // IN_CREATE
+    kqueue_flags |= NOTE_WRITE;
+  }
+  if (inotify_mask & 0x00000200) { // IN_DELETE
+    kqueue_flags |= NOTE_DELETE;
+  }
+  if (inotify_mask & 0x00000400) { // IN_DELETE_SELF
+    kqueue_flags |= NOTE_DELETE;
+  }
+  if (inotify_mask & 0x00000800) { // IN_MOVE_SELF
+    kqueue_flags |= NOTE_RENAME;
+  }
+  
+  return kqueue_flags;
+}
+}
+#endif
