diff --git a/host/libs/config/instance_nums.cpp b/host/libs/config/instance_nums.cpp
index 5cf2a7c90..ea4c82cb2 100644
--- a/host/libs/config/instance_nums.cpp
+++ b/host/libs/config/instance_nums.cpp
@@ -22,6 +22,7 @@
 #include "common/libs/utils/contains.h"
 #include "common/libs/utils/flag_parser.h"
 #include "host/libs/config/config_utils.h"
+#include "host/libs/config/instance_registry.h"
 
 namespace cuttlefish {
 
@@ -240,13 +241,27 @@ Result<std::vector<std::int32_t>> InstanceNumsCalculator::CalculateFromFlags() {
 Result<std::vector<std::int32_t>> InstanceNumsCalculator::Calculate() {
   CF_EXPECT(Result<void>(setter_result_));
 
-  if (!instance_nums_.empty() || base_instance_num_) {
+  // If explicit --instance_nums were given, use them as-is (no auto-assign).
+  if (!instance_nums_.empty()) {
     return CalculateFromFlags();
   }
 
+  // Determine the starting instance number from flags or system default.
+  std::int32_t start = base_instance_num_.value_or(GetInstance());
+  int num = num_instances_.value_or(1);
+
+  // Atomically claim free instance numbers from the registry so that
+  // concurrent launches get distinct ports, CIDs, and device IDs.
   std::vector<std::int32_t> instance_nums;
-  for (int i = 0; i < num_instances_.value_or(1); i++) {
-    instance_nums.push_back(i + GetInstance());
+  for (int i = 0; i < num; i++) {
+    auto claimed = ClaimNextFreeInstance(start);
+    if (!claimed.ok()) {
+      // Registry unavailable, fall back to sequential assignment.
+      instance_nums.push_back(start + i);
+      continue;
+    }
+    instance_nums.push_back(*claimed);
+    start = *claimed + 1;
   }
   CF_EXPECT(instance_nums.size() > 0, "no instance nums");
   return instance_nums;
