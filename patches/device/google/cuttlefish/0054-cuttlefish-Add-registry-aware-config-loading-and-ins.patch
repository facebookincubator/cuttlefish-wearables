+/*static*/ std::unique_ptr<const CuttlefishConfig>
+CuttlefishConfig::GetForInstance(int instance_num) {
+  auto result = GetInstanceConfigPath(instance_num);
+  if (!result.ok() || result->empty()) {
+    LOG(ERROR) << "No config found in registry for instance " << instance_num;
+    return nullptr;
+  }
+  return GetFromFile(*result);
+}
+
 // Creates the (initially empty) config object and populates it with values from
 // the config file if the CUTTLEFISH_CONFIG_FILE env variable is present.
+// Falls back to the global config symlink, then to the instance registry.
 // Returns nullptr if there was an error loading from file
 /*static*/ const CuttlefishConfig* CuttlefishConfig::Get() {
   auto config_file_path =
-      StringFromEnv(kCuttlefishConfigEnvVarName, GetGlobalConfigFileLink());
+      StringFromEnv(kCuttlefishConfigEnvVarName, "");
+  if (config_file_path.empty()) {
+    // Try global config symlink first
+    auto global_link = GetGlobalConfigFileLink();
+    if (FileExists(global_link)) {
+      config_file_path = global_link;
+    } else {
+      // Fall back to instance registry: check CUTTLEFISH_INSTANCE env var
+      auto instance_str = StringFromEnv("CUTTLEFISH_INSTANCE", "");
+      if (!instance_str.empty()) {
+        int instance_num = std::atoi(instance_str.c_str());
+        if (instance_num > 0) {
+          auto result = GetInstanceConfigPath(instance_num);
+          if (result.ok() && !result->empty()) {
+            config_file_path = *result;
+          }
+        }
+      }
+      if (config_file_path.empty()) {
+        config_file_path = global_link;  // will fail gracefully
+      }
+    }
+  }
   static std::shared_ptr<CuttlefishConfig> config(
       BuildConfigImpl(config_file_path));
   return config.get();
@@ -721,6 +755,13 @@ CuttlefishConfig::InstanceSpecific CuttlefishConfig::ForInstance(int num) const
 
