@@ -109,11 +109,28 @@ Result<void> SaveConfig(const CuttlefishConfig& tmp_config_obj) {
             "Failed to save to \"" << legacy_config_file << "\"");
 
   setenv(kCuttlefishConfigEnvVarName, config_file.c_str(), true);
+
+  // Always register each instance in the registry for multi-instance tracking.
+  for (const auto& instance : tmp_config_obj.Instances()) {
+    // PID will be updated later by launch_cvd when run_cvd starts.
+    // Use the parent (launch_cvd) PID so the entry stays alive after
+    // assemble_cvd exits, preventing concurrent launches from reclaiming
+    // this slot during the assemble→start transition.
+    CF_EXPECT(RegisterInstance(
+        instance.adb_host_port() - 6520 + 1,  // instance num
+        config_file, getppid()));
+  }
+
+  // Always create the global config symlink (unless in sandbox mode).
+  // Remove any stale symlink from a previous run first.
+  auto config_link = GetGlobalConfigFileLink();
   // TODO(schuffelen): Find alternative for host-sandboxing mode
   if (!InSandbox()) {
+    unlink(config_link.c_str());  // ignore error if it doesn't exist
     if (symlink(config_file.c_str(), config_link.c_str()) != 0) {
-      return CF_ERRNO("symlink(\"" << config_file << "\", \"" << config_link
-                                   << ") failed");
+      LOG(WARNING) << "Could not create config symlink \"" << config_link
+                   << "\" -> \"" << config_file << "\": " << strerror(errno)
+                   << ". Another instance may have created it.";
     }
   }
 
