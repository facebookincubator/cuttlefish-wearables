+  // Check registry for conflicts with already-running instances.
+  // Skip entries registered by the current launch pipeline (assemble_cvd
+  // registers a placeholder with getpid() which may be launch_cvd itself
+  // when running in-process).
+  auto my_pid = getpid();
+  auto parent_pid = getppid();
+  for (auto num : *instance_nums) {
+    auto running = IsInstanceRunning(num);
+    if (running.ok() && *running) {
+      auto entry = LookupInstance(num);
+      if (entry.ok() && entry->has_value()) {
+        auto registered_pid = entry->value().run_cvd_pid;
+        if (registered_pid == my_pid || registered_pid == parent_pid) {
+          continue;  // Placeholder from our own assemble phase
+        }
+        LOG(ERROR) << "Instance " << num << " is already running (pid "
+                   << registered_pid
+                   << "). Stop it first with: stop_cvd --instance_num="
+                   << num;
+        return -1;
+      }
+    }
+  }
+
 #if defined(__BIONIC__)
   // These environment variables are needed in case when Bionic is used.
   // b/171754977
