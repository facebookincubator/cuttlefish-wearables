-    if (!is_first_instance || !start_webrtc_vec[instance_index]) {
-      // Only the first instance starts the signaling server or proxy
+    // Each instance gets its own signaling server port so they can be
+    // started and stopped independently. Only use the flag value if
+    // explicitly set by the user; otherwise assign per-instance ports.
+    auto sig_port_info =
+        gflags::GetCommandLineFlagInfoOrDie("webrtc_sig_server_port");
+    auto port = sig_port_info.is_default ? 8443 + num - 1
+                                         : FLAGS_webrtc_sig_server_port;
+    instance.set_sig_server_port(port);
+
+    if (!start_webrtc_vec[instance_index]) {
       instance.set_start_webrtc_signaling_server(false);
       instance.set_start_webrtc_sig_server_proxy(false);
