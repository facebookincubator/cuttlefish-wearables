+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+#include "host/libs/config/netsim_watchdog.h"
+
+#include <fcntl.h>
+#include <signal.h>
+#include <sys/wait.h>
+#include <unistd.h>
+
+#include <chrono>
+#include <fstream>
+#include <string>
+#include <thread>
+
+#include <android-base/logging.h>
+#include <fmt/format.h>
+
+#include "common/libs/utils/files.h"
+#include "host/libs/config/netsim_state.h"
+
+namespace cuttlefish {
+
+namespace {
+
+constexpr int kPollIntervalSeconds = 5;
+
+// Get the directory where netsim writes its discovery INI files.
+// netsim uses $TMPDIR (which on macOS is /var/folders/...), NOT /tmp.
+std::string NetsimDiscoveryDir() {
+  const char* tmpdir = getenv("TMPDIR");
+  if (tmpdir && *tmpdir) {
+    return tmpdir;
+  }
+  return "/tmp";
+}
+
+std::string NetsimIniPath(int external_instance_num) {
+  std::string ini_name;
+  if (external_instance_num == 1) {
+    ini_name = "netsim.ini";
+  } else {
+    ini_name = fmt::format("netsim_{}.ini", external_instance_num);
+  }
+  auto tmp = NetsimDiscoveryDir();
+  return fmt::format("{}/{}", tmp, ini_name);
+}
+
+// Read the gRPC port from netsim's discovery INI file.
+Result<int> ReadGrpcPortFromIni(int external_instance_num) {
+  auto ini_path = NetsimIniPath(external_instance_num);
+
+  // Wait up to 10 seconds for the INI file to appear
+  for (int i = 0; i < 20; ++i) {
+    if (FileExists(ini_path)) {
+      std::ifstream ifs(ini_path);
+      std::string line;
+      while (std::getline(ifs, line)) {
+        if (line.find("grpc.port=") == 0) {
+          return std::stoi(line.substr(10));
+        }
+      }
+      LOG(WARNING) << "INI file exists but grpc.port= not found: " << ini_path;
+    }
+    std::this_thread::sleep_for(std::chrono::milliseconds(500));
+  }
+
+  return CF_ERR("Timed out waiting for netsim INI file: " << ini_path);
+}
+
+}  // namespace
+
+NetsimWatchdog::NetsimWatchdog(const std::string& netsimd_path,
+                               int netsim_instance_num, int hci_port,
+                               std::function<void()> connector_restart_fn)
+    : netsimd_path_(netsimd_path),
+      netsim_instance_num_(netsim_instance_num),
+      hci_port_(hci_port),
+      connector_restart_fn_(std::move(connector_restart_fn)) {}
+
+NetsimWatchdog::~NetsimWatchdog() { Stop(); }
+
+void NetsimWatchdog::Start() {
+  if (running_.load()) return;
+  running_.store(true);
+  thread_ = std::thread(&NetsimWatchdog::WatchdogLoop, this);
+}
+
+void NetsimWatchdog::Stop() {
+  running_.store(false);
+  if (thread_.joinable()) {
+    thread_.join();
+  }
+}
+
+void NetsimWatchdog::WatchdogLoop() {
+  while (running_.load()) {
+    std::this_thread::sleep_for(std::chrono::seconds(kPollIntervalSeconds));
+    if (!running_.load()) break;
+
+    auto state_result = NetsimState::Acquire();
+    if (!state_result.ok()) {
+      LOG(WARNING) << "Watchdog: failed to acquire netsim state: "
+                   << state_result.error().FormatForEnv();
+      continue;
+    }
+    auto& state = *state_result;
+
+    if (state.HasHealthyPrimary()) {
+      state.Release();
+      continue;
+    }
+
+    // Primary is dead — we won the race (flock ensures only one winner).
+    LOG(WARNING) << "Watchdog: netsim primary is dead, launching new one";
+
+    auto launch_result = LaunchNewPrimary(state);
+    if (!launch_result.ok()) {
+      LOG(ERROR) << "Watchdog: failed to launch new primary: "
+                 << launch_result.error().FormatForEnv();
+      state.Release();
+      continue;
+    }
+
+    // State was updated by LaunchNewPrimary, commit it
+    auto commit_result = state.Commit();
+    if (!commit_result.ok()) {
+      LOG(ERROR) << "Watchdog: failed to commit state: "
+                 << commit_result.error().FormatForEnv();
+      continue;
+    }
+
+    // Restart our local connector so it connects to the new primary.
+    if (connector_restart_fn_) {
+      LOG(INFO) << "Watchdog: restarting local connector";
+      connector_restart_fn_();
+    }
+  }
+}
+
+Result<void> NetsimWatchdog::LaunchNewPrimary(NetsimState& state) {
+  CF_EXPECT(FileExists(netsimd_path_),
+            "netsimd binary not found: " << netsimd_path_);
+
+  int external_instance_num = netsim_instance_num_ + 1;
+  auto instance_arg =
+      fmt::format("--instance_num={}", external_instance_num);
+  auto hci_port_arg = fmt::format("--hci_port={}", hci_port_);
+
+  auto stale_ini = NetsimIniPath(external_instance_num);
+  if (FileExists(stale_ini)) {
+    LOG(INFO) << "Watchdog: removing stale netsim INI: " << stale_ini;
+    unlink(stale_ini.c_str());
+  }
+
+  int max_fd = static_cast<int>(sysconf(_SC_OPEN_MAX));
+  if (max_fd < 0) max_fd = 1024;
+
+  int exec_pipe[2];
+  CF_EXPECT(pipe(exec_pipe) == 0, "pipe failed: " << strerror(errno));
+  fcntl(exec_pipe[1], F_SETFD, FD_CLOEXEC);
+
+  int pid_pipe[2];
+  CF_EXPECT(pipe(pid_pipe) == 0, "pipe failed: " << strerror(errno));
+
+  pid_t child1 = fork();
+  CF_EXPECT(child1 >= 0, "fork failed: " << strerror(errno));
+
+  if (child1 == 0) {
+    close(pid_pipe[0]);
+    close(exec_pipe[0]);
+
+    pid_t child2 = fork();
+    if (child2 < 0) _exit(1);
+    if (child2 > 0) {
+      write(pid_pipe[1], &child2, sizeof(child2));
+      close(pid_pipe[1]);
+      close(exec_pipe[1]);
+      _exit(0);
+    }
+
+    close(pid_pipe[1]);
+    setsid();
+    for (int fd = 3; fd < max_fd; ++fd) {
+      if (fd != exec_pipe[1]) close(fd);
+    }
+
+    execl(netsimd_path_.c_str(), "netsimd", instance_arg.c_str(),
+          hci_port_arg.c_str(), "--no_test_beacons", "--no_shutdown",
+          nullptr);
+    int err = errno;
+    write(exec_pipe[1], &err, sizeof(err));
+    _exit(1);
+  }
+
+  close(pid_pipe[1]);
+  close(exec_pipe[1]);
+  waitpid(child1, nullptr, 0);
+
+  pid_t grandchild;
+  auto n = read(pid_pipe[0], &grandchild, sizeof(grandchild));
+  close(pid_pipe[0]);
+  CF_EXPECT(n == static_cast<ssize_t>(sizeof(grandchild)),
+            "Failed to read grandchild PID");
+
+  int exec_err;
+  n = read(exec_pipe[0], &exec_err, sizeof(exec_err));
+  close(exec_pipe[0]);
+  CF_EXPECT(n == 0, "netsimd exec failed: " << strerror(exec_err));
+
+  auto port_result = ReadGrpcPortFromIni(external_instance_num);
+  if (!port_result.ok()) {
+    LOG(ERROR) << "Watchdog: killing orphaned netsimd (PID " << grandchild
+               << "): " << port_result.error().FormatForEnv();
+    kill(grandchild, SIGTERM);
+    return CF_ERR(port_result.error().FormatForEnv());
+  }
+  int grpc_port = *port_result;
+
+  // Verify the grandchild is still alive before registering it.
+  CF_EXPECT(kill(grandchild, 0) == 0,
+            "netsimd (PID " << grandchild << ") exited immediately after exec");
+
+  state.SetPrimary(grandchild, grpc_port, netsim_instance_num_, netsimd_path_);
+
+  LOG(INFO) << "Watchdog: new primary launched (PID " << grandchild
+            << ", gRPC port " << grpc_port << ")";
+  return {};
+}
+
+}  // namespace cuttlefish
