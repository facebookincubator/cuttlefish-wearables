+  // Launch a detached netsimd primary via double-fork to avoid zombies.
+  // Uses a CLOEXEC pipe to detect exec failures and closes inherited FDs
+  // in the grandchild before exec. Returns (pid, grpc_port).
+  Result<std::pair<pid_t, int>> LaunchDetachedPrimary() {
+    auto netsimd_path = HostBinaryPath("netsimd");
+    CF_EXPECT(FileExists(netsimd_path));
+
+    int external_instance_num = config_.netsim_instance_num() + 1;
+    auto instance_arg =
+        fmt::format("--instance_num={}", external_instance_num);
+    auto hci_port_arg =
+        fmt::format("--hci_port={}", config_.rootcanal_hci_port());
+
+    auto stale_ini = NetsimIniPath(external_instance_num);
+    if (FileExists(stale_ini)) {
+      LOG(INFO) << "Removing stale netsim INI: " << stale_ini;
+      unlink(stale_ini.c_str());
+    }
+
+    int max_fd = static_cast<int>(sysconf(_SC_OPEN_MAX));
+    if (max_fd < 0) max_fd = 1024;
+
+    // CLOEXEC pipe: successful exec auto-closes write end (parent reads 0);
+    // failed exec writes errno before _exit.
+    int exec_pipe[2];
+    CF_EXPECT(pipe(exec_pipe) == 0, "pipe failed: " << strerror(errno));
+    fcntl(exec_pipe[1], F_SETFD, FD_CLOEXEC);
+
+    // Pipe for intermediate child to send grandchild PID.
+    int pid_pipe[2];
+    CF_EXPECT(pipe(pid_pipe) == 0, "pipe failed: " << strerror(errno));
+
+    pid_t child1 = fork();
+    CF_EXPECT(child1 >= 0, "fork failed: " << strerror(errno));
+
+    if (child1 == 0) {
+      close(pid_pipe[0]);
+      close(exec_pipe[0]);
+
+      pid_t child2 = fork();
+      if (child2 < 0) _exit(1);
+      if (child2 > 0) {
+        // Intermediate child: send grandchild PID and exit immediately.
+        // Parent reaps us with waitpid; grandchild is reparented to init.
+        write(pid_pipe[1], &child2, sizeof(child2));
+        close(pid_pipe[1]);
+        close(exec_pipe[1]);
+        _exit(0);
       }
-      // Add uwb chip if enabled
-      if (config_.netsim_radio_enabled(CuttlefishConfig::NetsimRadio::Uwb)) {
-        Chip chip("UWB");
-        chip.fd_in = CF_EXPECT(MakeFifo(instance, "uwb_fifo_vm.in"));
-        chip.fd_out = CF_EXPECT(MakeFifo(instance, "uwb_fifo_vm.out"));
-        device.chips.emplace_back(chip);
+
+      // Grandchild: become session leader, close inherited FDs, exec.
+      close(pid_pipe[1]);
+      setsid();
+      for (int fd = 3; fd < max_fd; ++fd) {
+        if (fd != exec_pipe[1]) close(fd);
       }
-      // Add other chips if enabled
-      devices_.emplace_back(device);
+
+      execl(netsimd_path.c_str(), "netsimd", instance_arg.c_str(),
+            hci_port_arg.c_str(), "--no_test_beacons", "--no_shutdown",
+            nullptr);
+      int err = errno;
