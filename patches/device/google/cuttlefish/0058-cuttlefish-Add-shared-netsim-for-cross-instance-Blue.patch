index 000000000..93fba4c52
--- /dev/null
+++ b/host/libs/config/netsim_state.cpp
@@ -0,0 +1,239 @@
+/*
+ * Copyright (C) 2024 The Android Open Source Project
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *      http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+#include "host/libs/config/netsim_state.h"
+
+#include <errno.h>
+#include <signal.h>
+#include <sys/file.h>
+#include <sys/socket.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+#include <fstream>
+#include <sstream>
+#include <string>
+
+#include <android-base/logging.h>
+#include <fmt/format.h>
+#include <json/json.h>
+
+#include "common/libs/fs/shared_fd.h"
+#include "common/libs/utils/files.h"
+#include "common/libs/utils/known_paths.h"
+#include "common/libs/utils/result.h"
+
+namespace cuttlefish {
+
+namespace {
+
+constexpr char kPrimary[] = "primary";
+constexpr char kClients[] = "clients";
+constexpr char kPid[] = "pid";
+constexpr char kGrpcPort[] = "grpc_port";
+constexpr char kInstanceNum[] = "instance_num";
+constexpr char kNetsimdPath[] = "netsimd_path";
+constexpr char kInstanceId[] = "instance_id";
+constexpr char kRunCvdPid[] = "run_cvd_pid";
+constexpr char kDeviceName[] = "device_name";
+
+}  // namespace
+
+NetsimState::~NetsimState() {
+  if (lock_fd_->IsOpen() && !lock_released_) {
+    Release();
+  }
+}
+
+std::string NetsimState::StatePath() {
+  return fmt::format("{}/cf_avd_{}/netsim_state.json", TempDir(), getuid());
+}
+
+Result<NetsimState> NetsimState::Acquire() {
+  NetsimState state;
+
+  auto dir = fmt::format("{}/cf_avd_{}", TempDir(), getuid());
+  if (!DirectoryExists(dir)) {
+    CF_EXPECT(EnsureDirectoryExists(dir, 0770));
+  }
+
+  auto path = StatePath();
+
+  // Open or create the state file
+  state.lock_fd_ = SharedFD::Open(path, O_RDWR | O_CREAT, 0660);
+  CF_EXPECT(state.lock_fd_->IsOpen(),
+            "Failed to open netsim state file: " << path << ": "
+                                                 << state.lock_fd_->StrError());
+
+  // Acquire exclusive lock (blocks until available)
+  CF_EXPECT(state.lock_fd_->Flock(LOCK_EX));
+
+  // Read existing content
+  std::string content;
+  auto size = state.lock_fd_->LSeek(0, SEEK_END);
+  if (size > 0) {
+    state.lock_fd_->LSeek(0, SEEK_SET);
+    content.resize(size);
+    auto read = state.lock_fd_->Read(content.data(), size);
+    if (read > 0) {
+      content.resize(read);
+    } else {
+      content.clear();
+    }
+  }
+
+  // Parse JSON
+  if (!content.empty()) {
+    Json::Reader reader;
+    if (!reader.parse(content, state.state_)) {
+      LOG(WARNING) << "Failed to parse netsim state file, starting fresh";
+      state.state_ = Json::Value(Json::objectValue);
+    }
+  } else {
+    state.state_ = Json::Value(Json::objectValue);
+  }
+
+  if (!state.state_.isMember(kClients)) {
+    state.state_[kClients] = Json::Value(Json::arrayValue);
+  }
+
+  return state;
+}
+
+bool NetsimState::HasHealthyPrimary() const {
+  if (!state_.isMember(kPrimary)) return false;
+  const auto& primary = state_[kPrimary];
+  if (!primary.isMember(kPid)) return false;
+
+  pid_t pid = primary[kPid].asInt();
+  if (pid <= 0) return false;
+
+  // Check if process is alive
+  if (kill(pid, 0) != 0) {
+    return false;
+  }
+
+  // Check if gRPC port is accepting connections
+  if (!primary.isMember(kGrpcPort)) return false;
+  int port = primary[kGrpcPort].asInt();
+  auto fd = SharedFD::SocketLocalClient(port, SOCK_STREAM);
+  if (!fd->IsOpen() || fd->GetErrno() != 0) {
+    return false;
+  }
+  fd->Close();
+  return true;
+}
+
+void NetsimState::SetPrimary(pid_t pid, int grpc_port, int instance_num,
+                             const std::string& netsimd_path) {
+  state_[kPrimary] = Json::Value(Json::objectValue);
+  state_[kPrimary][kPid] = static_cast<int>(pid);
+  state_[kPrimary][kGrpcPort] = grpc_port;
+  state_[kPrimary][kInstanceNum] = instance_num;
+  state_[kPrimary][kNetsimdPath] = netsimd_path;
+}
+
+void NetsimState::ClearPrimary() {
+  state_.removeMember(kPrimary);
+}
+
+void NetsimState::AddClient(const std::string& instance_id,
+                            pid_t run_cvd_pid,
+                            const std::string& device_name) {
+  // Remove existing entry for this instance_id if any
+  RemoveClient(instance_id);
+
+  Json::Value client(Json::objectValue);
+  client[kInstanceId] = instance_id;
+  client[kRunCvdPid] = static_cast<int>(run_cvd_pid);
+  client[kDeviceName] = device_name;
+  state_[kClients].append(client);
+}
+
+bool NetsimState::RemoveClient(const std::string& instance_id) {
+  Json::Value new_clients(Json::arrayValue);
+  for (const auto& client : state_[kClients]) {
+    if (client[kInstanceId].asString() != instance_id) {
+      new_clients.append(client);
+    }
+  }
+  state_[kClients] = new_clients;
+  return new_clients.empty();
+}
+
+bool NetsimState::RemoveClientAndCleanup(const std::string& instance_id) {
+  bool was_last = RemoveClient(instance_id);
+  if (was_last) {
+    ClearPrimary();
+  }
+  return was_last;
+}
+
+int NetsimState::ClientCount() const {
+  return state_[kClients].size();
+}
+
+pid_t NetsimState::PrimaryPid() const {
+  if (!state_.isMember(kPrimary)) return -1;
+  return state_[kPrimary][kPid].asInt();
+}
+
+int NetsimState::PrimaryInstanceNum() const {
+  if (!state_.isMember(kPrimary)) return 0;
+  return state_[kPrimary][kInstanceNum].asInt();
+}
+
+int NetsimState::PrimaryGrpcPort() const {
+  if (!state_.isMember(kPrimary)) return 0;
+  return state_[kPrimary][kGrpcPort].asInt();
+}
+
+std::string NetsimState::PrimaryNetsimdPath() const {
+  if (!state_.isMember(kPrimary)) return "";
+  return state_[kPrimary][kNetsimdPath].asString();
+}
+
+Result<void> NetsimState::Commit() {
+  CF_EXPECT(lock_fd_->IsOpen(), "State file not open");
+
+  // Truncate and rewrite
+  CF_EXPECT(lock_fd_->LSeek(0, SEEK_SET) == 0);
+  CF_EXPECT(lock_fd_->Truncate(0) == 0);
+
+  std::ostringstream oss;
+  oss << state_;
+  auto data = oss.str();
+  auto written = lock_fd_->Write(data.data(), data.size());
+  CF_EXPECT(written == static_cast<ssize_t>(data.size()),
+            "Short write to state file");
+  CF_EXPECT(lock_fd_->Fsync() == 0);
+
+  // Release lock
+  lock_fd_->Flock(LOCK_UN);
+  lock_fd_->Close();
+  lock_released_ = true;
+  return {};
+}
+
+void NetsimState::Release() {
+  if (lock_fd_->IsOpen()) {
+    lock_fd_->Flock(LOCK_UN);
+    lock_fd_->Close();
+  }
+  lock_released_ = true;  // prevent destructor from double-releasing
+}
+
+}  // namespace cuttlefish
