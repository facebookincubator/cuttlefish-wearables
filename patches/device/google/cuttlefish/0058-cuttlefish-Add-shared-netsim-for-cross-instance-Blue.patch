+#pragma once
+
+#include <atomic>
+#include <functional>
+#include <string>
+#include <thread>
+
+#include "common/libs/utils/result.h"
+
+namespace cuttlefish {
+
+class NetsimState;
+
+// Background watchdog that monitors the health of a shared netsimd primary
+// and re-launches it if it crashes. Runs in each run_cvd process.
+//
+// Polls every 5 seconds. When the primary is detected as dead (PID gone or
+// gRPC unreachable), acquires the state file lock and launches a new primary.
+// The flock ensures only one watchdog wins the race in multi-instance setups.
+//
+// After launching a new primary, the watchdog calls the connector_restart_fn
+// callback so the caller can kill and restart its local connector process
+// (which needs to reconnect to the new primary).
+class NetsimWatchdog {
+ public:
+  // connector_restart_fn is called when a new primary has been launched and
+  // the local connector needs to be restarted.
+  // netsimd_path is the path to the netsimd binary for launching a new primary.
+  // netsim_instance_num is the internal instance number (0-based) for the
+  // primary.
+  NetsimWatchdog(const std::string& netsimd_path, int netsim_instance_num,
+                 int hci_port, std::function<void()> connector_restart_fn);
+  ~NetsimWatchdog();
+
+  NetsimWatchdog(const NetsimWatchdog&) = delete;
+  NetsimWatchdog& operator=(const NetsimWatchdog&) = delete;
+
+  void Start();
+  void Stop();
+
+ private:
+  void WatchdogLoop();
+  Result<void> LaunchNewPrimary(NetsimState& state);
+
+  std::string netsimd_path_;
+  int netsim_instance_num_;
+  int hci_port_;
+  std::function<void()> connector_restart_fn_;
+  std::atomic<bool> running_{false};
+  std::thread thread_;
+};
+
+}  // namespace cuttlefish
