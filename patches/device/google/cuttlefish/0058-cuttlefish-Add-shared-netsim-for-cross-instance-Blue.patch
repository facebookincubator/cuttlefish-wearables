+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *      http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+#pragma once
+
+#include <string>
+
+#include <json/json.h>
+
+#include "common/libs/fs/shared_fd.h"
+#include "common/libs/utils/result.h"
+
+namespace cuttlefish {
+
+// Manages shared netsim state across independently-launched Cuttlefish
+// instances. Uses /tmp/cf_avd_<uid>/netsim_state.json with flock() for atomic
+// coordination.
+//
+// When multiple emulators are launched independently, they need to share a
+// single netsimd primary. The first launcher starts a detached primary and
+// registers it here. Subsequent launchers detect the existing primary and
+// start as connectors. The state file tracks which instances are connected
+// so that cleanup happens correctly on stop.
+class NetsimState {
+ public:
+  NetsimState(NetsimState&& other) = default;
+  NetsimState& operator=(NetsimState&& other) = default;
+  NetsimState(const NetsimState&) = delete;
+  NetsimState& operator=(const NetsimState&) = delete;
+  ~NetsimState();
+
+  // Acquire an exclusive flock on the state file and read current state.
+  // The lock is held until Commit() or Release() is called (or destructor).
+  static Result<NetsimState> Acquire();
+
+  // Check if the registered primary is healthy:
+  //   1. PID is alive (kill(pid, 0) == 0)
+  //   2. gRPC port is accepting connections
+  bool HasHealthyPrimary() const;
+
+  // Register a detached primary netsimd.
+  void SetPrimary(pid_t pid, int grpc_port, int instance_num,
+                  const std::string& netsimd_path);
+
+  // Clear primary info (e.g., when last client stops).
+  void ClearPrimary();
+
+  // Add a client (emulator instance) to the state.
+  // instance_id is a unique string identifier (e.g., InstanceSpecific::id()).
+  void AddClient(const std::string& instance_id, pid_t run_cvd_pid,
+                 const std::string& device_name);
+
+  // Remove a client. Returns true if this was the last client.
+  bool RemoveClient(const std::string& instance_id);
+
+  // Atomically remove a client and clear primary info if this was the last.
+  // Returns true if this was the last client.
+  bool RemoveClientAndCleanup(const std::string& instance_id);
+
+  int ClientCount() const;
+
+  pid_t PrimaryPid() const;
+  int PrimaryInstanceNum() const;
+  int PrimaryGrpcPort() const;
+  std::string PrimaryNetsimdPath() const;
+
+  // Write updated state to disk and release the flock.
+  Result<void> Commit();
+
+  // Release the flock without writing changes.
+  void Release();
+
+  // Path to the state file.
+  static std::string StatePath();
+
+ private:
+  NetsimState() = default;
+
+  SharedFD lock_fd_;
+  Json::Value state_;
+  bool lock_released_ = false;
+};
+
+}  // namespace cuttlefish
