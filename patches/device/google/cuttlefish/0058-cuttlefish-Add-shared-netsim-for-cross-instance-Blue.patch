+void DeregisterNetsimClient(
+    const CuttlefishConfig::InstanceSpecific& instance) {
+  auto state_result = NetsimState::Acquire();
+  if (!state_result.ok()) {
+    // State file may not exist if netsim was never used — not an error.
+    return;
+  }
+  auto& state = *state_result;
+
+  // Remove + clear are a single operation under the held flock so no
+  // other instance can observe an intermediate state.
+  bool was_last = state.RemoveClientAndCleanup(instance.id());
+  if (was_last) {
+    LOG(INFO) << "Last netsim client deregistered, primary will auto-exit";
+  } else {
+    LOG(INFO) << "Deregistered netsim client (instance "
+              << instance.id() << "), "
+              << state.ClientCount() << " remaining";
+  }
+
+  auto commit_result = state.Commit();
+  if (!commit_result.ok()) {
+    LOG(WARNING) << "Failed to commit netsim state: "
+                 << commit_result.error().FormatForEnv();
+  }
+}
+
 int StopInstance(const CuttlefishConfig& config,
                  const CuttlefishConfig::InstanceSpecific& instance,
                  const std::int32_t wait_for_launcher) {
+  // Deregister from shared netsim state before stopping.
+  // This must happen before the process monitor kills the connector,
+  // so the state file accurately reflects remaining clients.
+  DeregisterNetsimClient(instance);
+
   auto result = CleanStopInstance(instance, wait_for_launcher);
   if (!result.ok()) {
     LOG(ERROR) << "Clean stop failed: " << result.error().FormatForEnv();
