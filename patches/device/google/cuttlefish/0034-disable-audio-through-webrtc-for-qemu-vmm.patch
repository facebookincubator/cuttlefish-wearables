---
 host/commands/run_cvd/launch/streamer.cpp | 13 +++++++++++--
 host/frontend/webrtc/main.cpp             | 11 +++++++++--
 2 files changed, 20 insertions(+), 4 deletions(-)

diff --git a/host/commands/run_cvd/launch/streamer.cpp b/host/commands/run_cvd/launch/streamer.cpp
index 58d5a0ea5..2b3887ba5 100644
--- a/host/commands/run_cvd/launch/streamer.cpp
+++ b/host/commands/run_cvd/launch/streamer.cpp
@@ -82,6 +82,15 @@ std::vector<Command> LaunchCustomActionServers(
   return commands;
 }
 
+// Returns true if the current VM configuration supports the audio server
+// socket for WebRTC streaming. QEMU handles audio internally via CoreAudio
+// (macOS) or disables it (Linux), and SOCK_SEQPACKET is not supported on
+// macOS for Unix sockets.
+bool SupportsAudioServer(const CuttlefishConfig& config,
+                         const CuttlefishConfig::InstanceSpecific& instance) {
+  return instance.enable_audio() && config.vm_manager() != VmmMode::kQemu;
+}
+
 // Creates the frame and input sockets and add the relevant arguments to
 // webrtc commands
 class StreamerSockets : public virtual SetupFeature {
@@ -123,7 +132,7 @@ class StreamerSockets : public virtual SetupFeature {
     cmd.AddParameter("-keyboard_fd=",
                      input_connections_provider_.KeyboardConnection());
     cmd.AddParameter("-frame_server_fd=", frames_server_);
-    if (instance_.enable_audio()) {
+    if (SupportsAudioServer(config_, instance_)) {
       cmd.AddParameter("--audio_server_fd=", audio_server_);
     }
     cmd.AddParameter("--confui_in_fd=", confui_in_fd_);
@@ -149,7 +158,7 @@ class StreamerSockets : public virtual SetupFeature {
     frames_server_ = CreateUnixInputServer(instance_.frames_socket_path());
     CF_EXPECT(frames_server_->IsOpen(), frames_server_->StrError());
     // TODO(schuffelen): Make this a separate optional feature?
-    if (instance_.enable_audio()) {
+    if (SupportsAudioServer(config_, instance_)) {
       auto path = config_.ForDefaultInstance().audio_server_path();
       audio_server_ =
           SharedFD::SocketLocalServer(path, false, SOCK_SEQPACKET, 0666);
diff --git a/host/frontend/webrtc/main.cpp b/host/frontend/webrtc/main.cpp
index 680557a3c..9127cfcc3 100644
--- a/host/frontend/webrtc/main.cpp
+++ b/host/frontend/webrtc/main.cpp
@@ -100,6 +100,9 @@ class CfOperatorObserver : public webrtc_streaming::OperatorObserver {
   }
 };
 std::unique_ptr<AudioServer> CreateAudioServer() {
+  if (FLAGS_audio_server_fd < 0) {
+    return nullptr;
+  }
   SharedFD audio_server_fd = SharedFD::Dup(FLAGS_audio_server_fd);
   close(FLAGS_audio_server_fd);
   return std::make_unique<AudioServer>(audio_server_fd);
@@ -367,12 +370,16 @@ int CuttlefishMain() {
   streamer->SetHardwareSpec("GPU Mode", user_friendly_gpu_mode);
 
   std::shared_ptr<AudioHandler> audio_handler;
-  if (instance.enable_audio()) {
+  // Only create AudioHandler if audio is enabled and we have a valid audio
+  // server socket. QEMU handles audio internally via CoreAudio, so no socket
+  // is provided in that case.
+  if (instance.enable_audio() && FLAGS_audio_server_fd >= 0) {
     int output_streams_count = instance.audio_output_streams_count();
     std::vector<std::shared_ptr<webrtc_streaming::AudioSink>> audio_streams(
         output_streams_count);
     for (int i = 0; i < audio_streams.size(); i++) {
-      audio_streams[i] = streamer->AddAudioStream("audio-" + std::to_string(i));
+      audio_streams[i] =
+          streamer->AddAudioStream("audio-" + std::to_string(i));
     }
     auto audio_server = CreateAudioServer();
     auto audio_source = streamer->GetAudioSource();
