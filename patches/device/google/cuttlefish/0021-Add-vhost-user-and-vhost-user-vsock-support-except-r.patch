 namespace cuttlefish {
 
+#ifdef __APPLE__
+// macOS kqueue-based epoll emulation
+namespace {
+struct KqueueEventData {
+  SharedFD fd;
+  uint32_t events;
+};
+
+// Global storage for kqueue event data
+static std::mutex kqueue_mutex;
+static std::unordered_map<int, std::unordered_map<int, KqueueEventData>> kqueue_data; // kqueue_fd -> fd -> KqueueEventData
+
+uint16_t EpollEventsToKqueueFilter(uint32_t epoll_events) {
+  uint16_t kqueue_filter = 0;
+  if (epoll_events & EPOLLIN) {
+    kqueue_filter |= EVFILT_READ;
+  }
+  if (epoll_events & EPOLLOUT) {
+    kqueue_filter |= EVFILT_WRITE;
+  }
+  return kqueue_filter;
+}
+
+uint32_t KqueueEventsToEpoll(uint16_t kqueue_filter, uint16_t kqueue_flags) {
+  uint32_t epoll_events = 0;
+  if (kqueue_filter == EVFILT_READ) {
+    epoll_events |= EPOLLIN;
+  }
+  if (kqueue_filter == EVFILT_WRITE) {
+    epoll_events |= EPOLLOUT;
+  }
+  if (kqueue_flags & EV_EOF) {
+    epoll_events |= EPOLLHUP;
+  }
+  if (kqueue_flags & EV_ERROR) {
+    epoll_events |= EPOLLERR;
+  }
+  return epoll_events;
+}
+}
+#endif
+
 Result<Epoll> Epoll::Create() {
+#ifdef __linux__
   int fd = epoll_create1(EPOLL_CLOEXEC);
   if (fd == -1) {
     return CF_ERRNO("Failed to create epoll");
   }
+#elif defined(__APPLE__)
+  int fd = kqueue();
+  if (fd == -1) {
+    return CF_ERRNO("Failed to create kqueue");
+  }
+  // Set CLOEXEC flag
+  fcntl(fd, F_SETFD, FD_CLOEXEC);
+  
+  // Initialize the event data tracking for this kqueue
+  std::lock_guard<std::mutex> lock(kqueue_mutex);
+  kqueue_data[fd] = std::unordered_map<int, KqueueEventData>();
+#else
+  return CF_ERR("epoll not supported on this platform");
+#endif
+  
   SharedFD shared{std::shared_ptr<FileInstance>(new FileInstance(fd, 0))};
   return Epoll(shared);
 }
@@ -75,6 +139,8 @@ Result<void> Epoll::Add(SharedFD fd, uint32_t events) {
