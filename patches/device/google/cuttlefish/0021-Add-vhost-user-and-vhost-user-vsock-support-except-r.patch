@@ -136,15 +254,48 @@ Result<void> Epoll::Delete(SharedFD fd) {
   if (watched_.count(fd) == 0) {
     return CF_ERR("Watched set did not contain fd");
   }
+
+#ifdef __linux__
   int success = epoll_ctl(epoll_fd_->fd_, EPOLL_CTL_DEL, fd->fd_, nullptr);
   if (success != 0) {
     return CF_ERRNO("epoll_ctl: Delete failed");
   }
+#elif defined(__APPLE__)
+  // Get the events for this fd to know which filters to delete
+  uint32_t events = 0;
+  {
+    std::lock_guard<std::mutex> lock(kqueue_mutex);
+    auto kqueue_it = kqueue_data.find(epoll_fd_->fd_);
+    if (kqueue_it != kqueue_data.end()) {
+      auto fd_it = kqueue_it->second.find(fd->fd_);
+      if (fd_it != kqueue_it->second.end()) {
+        events = fd_it->second.events;
