+  // Helper to create a file after a delay
+  void CreateFileAfterDelay(const std::string& path, int delay_ms) {
+    std::thread([path, delay_ms]() {
+      std::this_thread::sleep_for(std::chrono::milliseconds(delay_ms));
+      int fd = open(path.c_str(), O_CREAT | O_WRONLY, 0644);
+      if (fd >= 0) {
