+    std::thread([path, delay_ms, listen]() {
+      std::this_thread::sleep_for(std::chrono::milliseconds(delay_ms));
+      
+      int sock_fd = socket(AF_UNIX, SOCK_STREAM, 0);
+      if (sock_fd < 0) return;
+      
+      struct sockaddr_un addr;
+      memset(&addr, 0, sizeof(addr));
+      addr.sun_family = AF_UNIX;
+      strncpy(addr.sun_path, path.c_str(), sizeof(addr.sun_path) - 1);
+      
+      unlink(path.c_str());
+      if (bind(sock_fd, (struct sockaddr*)&addr, sizeof(addr)) < 0) {
+        close(sock_fd);
+        return;
+      }
+      
+      if (listen) {
+        if (::listen(sock_fd, 5) < 0) {
+          close(sock_fd);
+          return;
+        }
+      }
+      
+      // Keep the socket open for a while to allow tests to complete
+      std::this_thread::sleep_for(std::chrono::milliseconds(500));
+      close(sock_fd);
+    }).detach();
+  }
+
+  std::string temp_dir_;
+};
+
+TEST_F(FileMonitorTest, WaitForFileSuccess) {
+  std::string test_file = temp_dir_ + "/test_file";
+  
+  // Create the file after a short delay
+  CreateFileAfterDelay(test_file, 100);
+  
+  // Wait for the file to be created
+  auto result = WaitForFile(test_file, 2);
+  EXPECT_TRUE(result.ok()) << result.error().Trace();
+  EXPECT_TRUE(FileExists(test_file));
+}
+
+TEST_F(FileMonitorTest, WaitForFileTimeout) {
+  std::string test_file = temp_dir_ + "/nonexistent_file";
+  
+  // Wait for the file with a short timeout
+  auto result = WaitForFile(test_file, 1);
+  EXPECT_FALSE(result.ok());
+}
+
+TEST_F(FileMonitorTest, WaitForUnixSocketSuccess) {
+  std::string socket_path = temp_dir_ + "/test_socket";
+  
+  // Create the socket after a short delay
+  CreateUnixSocketAfterDelay(socket_path, 100);
+  
+  // Wait for the socket to be created
+  auto result = WaitForUnixSocket(socket_path, 2);
+  EXPECT_TRUE(result.ok()) << result.error().Trace();
+  EXPECT_TRUE(FileIsSocket(socket_path));
+}
+
+TEST_F(FileMonitorTest, WaitForUnixSocketTimeout) {
+  std::string socket_path = temp_dir_ + "/nonexistent_socket";
+  
+  // Wait for the socket with a short timeout
+  auto result = WaitForUnixSocket(socket_path, 1);
+  EXPECT_FALSE(result.ok());
+}
+
+TEST_F(FileMonitorTest, WaitForUnixSocketListeningSuccess) {
+  std::string socket_path = temp_dir_ + "/listening_socket";
+  
+  // Create the listening socket after a short delay
+  CreateUnixSocketAfterDelay(socket_path, 100, true);
+  
+  // Wait for the socket to be created and in listening state
+  auto result = WaitForUnixSocketListeningWithoutConnect(socket_path, 2);
+  EXPECT_TRUE(result.ok()) << result.error().Trace();
+  EXPECT_TRUE(FileIsSocket(socket_path));
+}
+
+#ifdef __APPLE__
+TEST_F(FileMonitorTest, InotifyCompatibilityOnMac) {
+  // Test the inotify compatibility layer on macOS
+  int kq = inotify_init1(0);
+  EXPECT_GE(kq, 0);
+  
+  // Add a watch on the temp directory
+  int wd = inotify_add_watch(kq, temp_dir_.c_str(), IN_CREATE);
+  EXPECT_GE(wd, 0);
+  
+  // Create a file in the directory
+  std::string test_file = temp_dir_ + "/inotify_test_file";
+  CreateFileAfterDelay(test_file, 100);
+  
+  // Wait a bit for the event to be processed
+  std::this_thread::sleep_for(std::chrono::milliseconds(200));
+  
+  // Check if we can get events
+  auto file_list = GetFileListFromInotifyFd(kq, IN_CREATE);
+  
+  // Clean up
+  inotify_rm_watch(kq, wd);
+  close(kq);
+  
+  // We should have detected at least one file
+  EXPECT_FALSE(file_list.empty());
+}
+#endif
