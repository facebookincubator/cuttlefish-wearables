 Result<SharedFD> VsockServer::Start() {
+  LOG(INFO) << "Starting vsock server - Port: " << port_ 
+            << ", vhost-user CID: " << (vhost_user_vsock_cid_.has_value() ? 
+                std::to_string(vhost_user_vsock_cid_.value()) : "none (standard vsock)");
+  
+  if (vhost_user_vsock_cid_.has_value()) {
+    LOG(DEBUG) << "Using vhost-user vsock backend with CID: " << vhost_user_vsock_cid_.value();
+  } else {
+    LOG(DEBUG) << "Using standard vsock backend";
+  }
+
   SharedFD server;
+  int attempt_count = 0;
   do {
+    attempt_count++;
+    LOG(DEBUG) << "vsock server connection attempt #" << attempt_count;
+    
     server = SharedFD::VsockServer(port_, SOCK_STREAM, vhost_user_vsock_cid_);
-    if (!server->IsOpen() && !socketErrorIsRecoverable(server->GetErrno())) {
+    
+    if (server->IsOpen()) {
+      LOG(INFO) << "Successfully started vsock server - Port: " << port_
+                << ", vhost-user CID: " << (vhost_user_vsock_cid_.has_value() ? 
+                    std::to_string(vhost_user_vsock_cid_.value()) : "none")
+                << ", attempts: " << attempt_count;
+      
+      LOG(DEBUG) << "vsock server ready for IO operations and client connections";
+      break;
+    }
+    
+    int current_errno = server->GetErrno();
+    std::string error_str = server->StrError();
+    
+    if (!socketErrorIsRecoverable(current_errno)) {
+      LOG(ERROR) << "Unrecoverable vsock server error - Port: " << port_
+                 << ", vhost-user CID: " << (vhost_user_vsock_cid_.has_value() ? 
+                     std::to_string(vhost_user_vsock_cid_.value()) : "none")
+                 << ", Error: " << error_str << " (errno: " << current_errno << ")"
+                 << ", attempts: " << attempt_count;
+      
+      // Additional vhost-user specific error logging
+      if (vhost_user_vsock_cid_.has_value()) {
+        LOG(ERROR) << "vhost-user vsock server failed with unrecoverable error - this may indicate:"
+                   << " vhost-user device unavailable, incorrect CID configuration, "
+                   << "socket permissions issues, or backend misconfiguration";
+      }
+      
       LOG(ERROR) << "Could not open vsock socket: " << server->StrError();
       // socket_vsock_proxy will now wait forever in the guest on encountering an
       // "unrecoverable" errno. This is to prevent churn from being restarted by
       // init.vsoc.rc.
       SleepForever();
+    } else {
+      LOG(WARNING) << "Recoverable vsock server error - Port: " << port_
+                   << ", vhost-user CID: " << (vhost_user_vsock_cid_.has_value() ? 
+                       std::to_string(vhost_user_vsock_cid_.value()) : "none")
+                   << ", Error: " << error_str << " (errno: " << current_errno << ")"
+                   << ", attempt: " << attempt_count << " - retrying...";
+      
+      if (vhost_user_vsock_cid_.has_value()) {
+        LOG(DEBUG) << "vhost-user vsock server retry - checking vhost-user device availability";
+      }
     }
   } while (!server->IsOpen());
 
