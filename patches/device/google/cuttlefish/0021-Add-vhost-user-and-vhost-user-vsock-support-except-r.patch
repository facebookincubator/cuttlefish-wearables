+static Result<void> WaitForFileInternal(const std::string& path, int timeoutSec,
+                                        int kq) {
+  CF_EXPECT_NE(path, "", "Path is empty");
+
+  if (FileExists(path, true)) {
+    return {};
+  }
+
+  const auto targetTime =
+      std::chrono::system_clock::now() + std::chrono::seconds(timeoutSec);
+
+  const std::string parentPath = android::base::Dirname(path);
+  const std::string filename = android::base::Basename(path);
+
+  CF_EXPECT(WaitForFile(parentPath, timeoutSec),
+            "Error while waiting for parent directory creation");
+
+  // Watch the parent directory for file creation events
+  auto watcher = KqueueWatcher(kq, parentPath, NOTE_WRITE | NOTE_EXTEND);
+
+  if (FileExists(path, true)) {
+    return {};
+  }
+
+  while (true) {
+    const auto currentTime = std::chrono::system_clock::now();
+
+    if (currentTime >= targetTime) {
+      return CF_ERR("Timed out");
+    }
+
+    const auto currentTimeRemain = targetTime - currentTime;
+    if (currentTimeRemain.count() <= 0) {
+      return CF_ERR("Timed out");
+    }
+    
+    // Convert to seconds and nanoseconds for timespec
+    const auto seconds = std::chrono::duration_cast<std::chrono::seconds>(currentTimeRemain);
+    const auto nanoseconds = std::chrono::duration_cast<std::chrono::nanoseconds>(
+        currentTimeRemain - seconds);
+    
+    struct timespec timeout;
+    timeout.tv_sec = seconds.count();
+    timeout.tv_nsec = nanoseconds.count();
+
+    // Wait for events
+    struct kevent event;
+    int ret = kevent(kq, nullptr, 0, &event, 1, &timeout);
+
+    if (ret == 0) {
+      // This is just a timeout from kevent, not an error
+      // Check if the file exists now (it might have been created between our last check and now)
+      if (FileExists(path, true)) {
+        return {};
+      }
+      
+      // Continue the loop to check again or timeout if we've exceeded the total time
+      continue;
+    } else if (ret < 0) {
+      return CF_ERRNO("kevent() failed");
+    }
+
+    // Check if our file exists now
+    if (FileExists(path, true)) {
+      return {};
+    }
+  }
+
+  return CF_ERR("This shouldn't be executed");
+}
+
+auto WaitForFile(const std::string& path, int timeoutSec)
+    -> decltype(WaitForFileInternal(path, timeoutSec, 0)) {
+  android::base::unique_fd kq(kqueue());
+  CF_EXPECT(kq.get() >= 0, "Failed to create kqueue");
+
+  CF_EXPECT(WaitForFileInternal(path, timeoutSec, kq.get()));
+
+  return {};
+}
