---
 libteeui/include/teeui/incfont.h | 21 +++++++++++++++++++++
 1 file changed, 21 insertions(+)

diff --git a/libteeui/include/teeui/incfont.h b/libteeui/include/teeui/incfont.h
index 59a9183..b60efa8 100644
--- a/libteeui/include/teeui/incfont.h
+++ b/libteeui/include/teeui/incfont.h
@@ -20,19 +20,40 @@
 
 #ifdef __ASSEMBLY__
 .macro TEEUI_ASM_INCFONT fontname, filename
+#ifdef __APPLE__
+.section __TEXT,__const
+.align 4
+.globl _\fontname
+_\fontname:
+#else
 .section .rodata
 .align 4
 .globl \fontname
 \fontname:
+#endif
 .incbin "\filename"
+#ifdef __APPLE__
+.section __TEXT,__const
+.align 1
+_\fontname\()_end:
+#else
 .section .rodata
 .align 1
 \fontname\()_end:
+#endif
+#ifdef __APPLE__
+.section __TEXT,__const
+.align 4
+.globl _\fontname\()_length
+_\fontname\()_length:
+.long _\fontname\()_end - _\fontname - 1
+#else
 .section .rodata
 .align 4;
 .globl \fontname\()_length
 \fontname\()_length:
 .long \fontname\()_end - \fontname - 1
+#endif
 .endmacro
 
 #define TEEUI_INCFONT(fontname, filename) TEEUI_ASM_INCFONT fontname, filename
