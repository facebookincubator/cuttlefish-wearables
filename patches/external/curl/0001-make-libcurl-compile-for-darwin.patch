From 74dce269c2710479b2b07a3ad05f65ddf496632c Mon Sep 17 00:00:00 2001
From: Alex Chong <achong@meta.com>
Date: Mon, 4 Aug 2025 09:45:23 -0700
Subject: [PATCH] make libcurl compile for darwin

Summary:
# Motivation:
This is required by multiple cuttlefish host binaries

# Overview:
- support building on mac

Test Plan:
```
. build/envsetup.sh
 lunch aosp_cf_arm64_phone-userdebug
 m out/host/darwin-x86/cvd-host_package.tar.gz -k &> ~/build.logs.txt
```

Rollback Plan:

Reviewers: tcare, #cuttlefish-cross-platform, benthomas

Reviewed By: tcare

Subscribers: ryanyu, <internal-group>

Differential Revision: https://phabricator.intern.facebook.com/D79567479

Tags: aarch64
---
 Android.bp        | 6 +++++-
 lib/curl_config.h | 8 ++++++++
 2 files changed, 13 insertions(+), 1 deletion(-)

diff --git a/Android.bp b/Android.bp
index 2bcd4362e..5e9dc8176 100644
--- a/Android.bp
+++ b/Android.bp
@@ -108,7 +108,11 @@ cc_library {
             cflags: ["-D_GNU_SOURCE=1"],
         },
         darwin: {
-            enabled: false,
+            enabled: true,
+            host_ldlibs: [
+                "-framework CoreFoundation",
+                "-framework SystemConfiguration",
+            ],
         },
     },
     unique_host_soname: true,
diff --git a/lib/curl_config.h b/lib/curl_config.h
index 06d5da0d8..5fcbb7b69 100644
--- a/lib/curl_config.h
+++ b/lib/curl_config.h
@@ -227,7 +227,9 @@
 #define HAVE_DLFCN_H 1
 
 /* Define to 1 if you have the `eventfd' function. */
+#ifdef __linux__
 #define HAVE_EVENTFD 1
+#endif
 
 /* Define to 1 if you have the fcntl function. */
 #define HAVE_FCNTL 1
@@ -426,7 +428,9 @@
 /* #undef HAVE_LIBZSTD */
 
 /* Define to 1 if you have the <linux/tcp.h> header file. */
+#ifdef __linux__
 #define HAVE_LINUX_TCP_H 1
+#endif
 
 /* Define to 1 if you have the <locale.h> header file. */
 #define HAVE_LOCALE_H 1
@@ -438,7 +442,9 @@
 /* #undef HAVE_MACH_ABSOLUTE_TIME */
 
 /* Define to 1 if you have the memrchr function or macro. */
+#ifdef __linux__
 #define HAVE_MEMRCHR 1
+#endif
 
 /* Define to 1 if you have the MSG_NOSIGNAL flag. */
 #define HAVE_MSG_NOSIGNAL 1
@@ -651,7 +657,9 @@
 #define HAVE_SUSECONDS_T 1
 
 /* Define to 1 if you have the <sys/eventfd.h> header file. */
+#ifdef __linux__
 #define HAVE_SYS_EVENTFD_H 1
+#endif
 
 /* Define to 1 if you have the <sys/filio.h> header file. */
 /* #undef HAVE_SYS_FILIO_H */
