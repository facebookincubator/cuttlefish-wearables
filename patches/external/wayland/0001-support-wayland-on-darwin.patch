 static int
 set_timer(int timerfd, struct timespec deadline) {
+#ifdef __APPLE__
+	struct kevent ke;
+	struct timespec now;
+	struct timespec interval;
+
+	clock_gettime(CLOCK_MONOTONIC, &now);
+	interval.tv_sec = deadline.tv_sec - now.tv_sec;
+	interval.tv_nsec = deadline.tv_nsec - now.tv_nsec;
+	if (interval.tv_nsec < 0) {
+		interval.tv_sec -= 1;
+		interval.tv_nsec += 1000000000L;
+	}
+
+	EV_SET(&ke, timerfd, EVFILT_TIMER, EV_ADD | EV_ENABLE, 0, interval.tv_sec * 1000 + interval.tv_nsec / 1000000, NULL);
+	return kevent(timerfd, &ke, 1, NULL, 0, NULL);
+#else
 	struct itimerspec its;
 
 	its.it_interval.tv_sec = 0;
 	its.it_interval.tv_nsec = 0;
