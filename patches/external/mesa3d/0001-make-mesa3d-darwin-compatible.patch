From 511aec968ba6807bf5894ea92162145879c40a2f Mon Sep 17 00:00:00 2001
From: Alex Chong <achong@meta.com>
Date: Mon, 4 Aug 2025 10:00:55 -0700
Subject: [PATCH] make mesa3d darwin compatible

Summary:
# Motivation:
Mesa3d is required for webrtc host utils for cuttlefish
# Overview:
- change bp file to compile on darwin

Test Plan:
```
. build/envsetup.sh
 lunch aosp_cf_arm64_phone-userdebug
 m out/host/darwin-x86/cvd-host_package.tar.gz -k &> ~/build.logs.txt
```

Rollback Plan:

Reviewers: tcare, #cuttlefish-cross-platform, benthomas

Reviewed By: tcare

Subscribers: ryanyu, #wearables_emulators

Differential Revision: https://phabricator.intern.facebook.com/D79568546

Tags: aarch64
---
 Android.bp                              | 10 +++++++---
 src/gallium/targets/lavapipe/Android.bp | 23 ++++++++++++++++-------
 src/util/Android.bp                     |  8 +++++---
 src/util/u_endian.h                     |  4 ++++
 4 files changed, 32 insertions(+), 13 deletions(-)

diff --git a/Android.bp b/Android.bp
index 9493cdb0d0c..a59bfdfb497 100644
--- a/Android.bp
+++ b/Android.bp
@@ -159,10 +159,8 @@ cc_defaults {
         "-DHAVE___BUILTIN_UNREACHABLE",
         "-DHAVE_PTHREAD=1",
         "-DHAVE_DLADDR",
-        "-DHAVE_DL_ITERATE_PHDR",
         "-DHAVE_LINUX_FUTEX_H",
         "-DHAVE_ENDIAN_H",
-        "-DMAJOR_IN_SYSMACROS",
         "-DMESA_DEBUG=0",
         "-fvisibility=hidden",
         "-fno-math-errno",
@@ -233,7 +231,6 @@ cc_defaults {
         host: {
             cflags: [
                 "-D_GNU_SOURCE",
-                "-DHAVE_SECURE_GETENV",
             ],
         },
         android: {
@@ -246,5 +243,12 @@ cc_defaults {
                 "-DHAVE_REALLOCARRAY",
             ],
         },
+        linux: {
+            cflags: [
+                "-DHAVE_DL_ITERATE_PHDR",
+                "-DHAVE_SECURE_GETENV",
+                "-DMAJOR_IN_SYSMACROS",
+            ],
+        }
     },
 }
diff --git a/src/gallium/targets/lavapipe/Android.bp b/src/gallium/targets/lavapipe/Android.bp
index 81e057a0127..fd4b960254c 100644
--- a/src/gallium/targets/lavapipe/Android.bp
+++ b/src/gallium/targets/lavapipe/Android.bp
@@ -72,13 +72,6 @@ cc_library_shared {
         "-DGALLIUM_LLVMPIPE",
         "-DLVP_USE_WSI_PLATFORM",
     ],
-    ldflags: [
-        // Mesa always adds Bsymbolic when available (see 'ld_args_bsymbolic' in Meson build). Duplicate that
-        // behavior here. '--gc-sections' has stronger justification: this lets drivers drop
-        // shared code unused by that specific driver (particularly relevant for Vulkan drivers).
-        "-Wl,-Bsymbolic",
-        "-Wl,--gc-sections",
-    ],
     whole_static_libs: [
         "mesa_vulkan_util",
         "mesa_vulkan_runtime",
@@ -126,5 +119,21 @@ cc_library_shared {
                 "libcutils",
             ],
         },
+        linux: {
+            ldflags: [
+                // Mesa always adds Bsymbolic when available (see 'ld_args_bsymbolic' in Meson build). Duplicate that
+                // behavior here. '--gc-sections' has stronger justification: this lets drivers drop
+                // shared code unused by that specific driver (particularly relevant for Vulkan drivers).
+                "-Wl,-Bsymbolic",
+                "-Wl,--gc-sections",
+            ],
+        },
+        darwin: {
+            ldflags: [
+                "-Wl,-flat_namespace",
+                "-Wl,-undefined,suppress",
+                "-Wl,-dead_strip",
+            ],
+        }
     },
 }
diff --git a/src/util/Android.bp b/src/util/Android.bp
index 33b7c74987b..5cfb15d2ae6 100644
--- a/src/util/Android.bp
+++ b/src/util/Android.bp
@@ -179,9 +179,6 @@ cc_library_static {
             header_libs: [
                 "mesa_common_headers",
             ],
-            cflags: [
-                "-DHAVE_PROGRAM_INVOCATION_NAME",
-            ],
         },
         android: {
             header_libs: [
@@ -191,6 +188,11 @@ cc_library_static {
                 "-DHAVE_MEMFD_CREATE",
             ],
         },
+        linux: {
+            cflags: [
+                "-DHAVE_PROGRAM_INVOCATION_NAME",
+            ],
+        },
     },
 }
 
diff --git a/src/util/u_endian.h b/src/util/u_endian.h
index b01f73017ae..2022fa7c5ad 100644
--- a/src/util/u_endian.h
+++ b/src/util/u_endian.h
@@ -28,7 +28,11 @@
 #define U_ENDIAN_H
 
 #ifdef HAVE_ENDIAN_H
+#ifdef __APPLE__
+#include <machine/endian.h>
+#else
 #include <endian.h>
+#endif
 
 /* glibc */
 #if defined(__BYTE_ORDER) && (__BYTE_ORDER == __LITTLE_ENDIAN)
