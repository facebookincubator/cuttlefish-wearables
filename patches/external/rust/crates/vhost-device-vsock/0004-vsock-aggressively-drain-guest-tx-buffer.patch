+    /// Aggressive TX buffer draining for improved flow control
+    fn aggressive_tx_drain(&mut self) {
+        let mut drained_connections = 0;
+        let mut total_bytes_drained = 0;
+        
+        // Drain all connections with pending TX data
+        for conn in self.thread_backend.conn_map.values_mut() {
+            if !conn.tx_buf.is_empty() {
+                match conn.tx_buf.flush_to(&mut conn.stream) {
+                    Ok(bytes_drained) => {
+                        if bytes_drained > 0 {
+                            conn.fwd_cnt += std::num::Wrapping(bytes_drained as u32);
+                            conn.rx_queue.enqueue(RxOps::CreditUpdate);
+                            drained_connections += 1;
+                            total_bytes_drained += bytes_drained;
+                            
+                            // Add to RX queue for processing credit update
+                            self.thread_backend.backend_rxq.push_back(
+                                ConnMapKey::new(conn.local_port, conn.peer_port)
+                            );
+                        }
+                    }
+                    Err(e) => {
+                        debug!("Failed to drain TX buffer for connection: {:?}", e);
+                    }
+                }
+            }
+        }
+        
+        if total_bytes_drained > 0 {
+            debug!(
+                "Aggressive TX drain: {} connections, {} bytes drained",
+                drained_connections, total_bytes_drained
+            );
+        }
+    }
+
