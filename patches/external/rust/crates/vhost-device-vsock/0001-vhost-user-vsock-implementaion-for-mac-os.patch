+#[cfg(target_os = "linux")]
+use epoll;
+
+#[cfg(target_os = "macos")]
+pub mod epoll {
+    use super::*;
+    use std::collections::HashMap;
+    use std::os::unix::io::RawFd;
+    use std::sync::Mutex;
+    use vmm_sys_util::epoll::{ControlOperation, Epoll, EpollEvent, EventSet};
+    use log::{debug, warn, error};
+
+    pub struct Events(u32);
+
+    impl Events {
+        pub const EPOLLIN: Events = Events(EventSet::IN.bits());
+        pub const EPOLLOUT: Events = Events(EventSet::OUT.bits());
+
+        pub fn empty() -> Self {
+            Events(0)
+        }
+
+        pub fn bits(&self) -> u32 {
+            self.0
+        }
+
+        pub fn from_bits(bits: u32) -> Option<Self> {
+            Some(Events(bits))
+        }
+    }
+
+    impl std::ops::BitOr for Events {
+        type Output = Self;
+
+        fn bitor(self, rhs: Self) -> Self::Output {
+            Events(self.0 | rhs.0)
+        }
+    }
+
+    #[derive(Clone)]
+    pub struct Event {
+        pub events: u32,
+        pub data: u64,
+    }
+
+    impl Event {
+        pub fn new(events: Events, data: u64) -> Self {
+            Event {
+                events: events.0,
+                data,
+            }
+        }
+    }
+
+    #[derive(Debug)]
+    pub enum ControlOptions {
+        EPOLL_CTL_ADD,
+        EPOLL_CTL_MOD,
+        EPOLL_CTL_DEL,
+    }
+
+    // Thread-safe storage for epoll instances - use Box to avoid moving the Epoll
+    lazy_static::lazy_static! {
+        static ref EPOLL_INSTANCES: Mutex<HashMap<RawFd, Box<Epoll>>> = Mutex::new(HashMap::new());
+    }
+
+    pub fn create(_close_on_exec: bool) -> std::io::Result<RawFd> {
+        debug!("Creating new epoll instance");
+        let epoll = Epoll::new()?;
+        let fd = epoll.as_raw_fd();
+        debug!("Created epoll instance with fd: {}", fd);
+
+        // Store the epoll instance in our global map
+        let mut instances = EPOLL_INSTANCES.lock().unwrap();
+        instances.insert(fd, Box::new(epoll));
+        debug!("Stored epoll instance in global map, total instances: {}", instances.len());
+
+        Ok(fd)
+    }
+
+    pub fn ctl(epoll_fd: RawFd, op: ControlOptions, fd: RawFd, event: Event) -> std::io::Result<()> {
+        debug!("epoll_ctl: epoll_fd={}, op={:?}, fd={}, events={}",
+               epoll_fd, op, fd, event.events);
+
+        let control_op = match op {
+            ControlOptions::EPOLL_CTL_ADD => ControlOperation::Add,
+            ControlOptions::EPOLL_CTL_MOD => ControlOperation::Modify,
+            ControlOptions::EPOLL_CTL_DEL => ControlOperation::Delete,
+        };
+
+        let event_set = EventSet::from_bits(event.events).unwrap_or_else(|| {
+            warn!("Invalid event bits: {}, using empty", event.events);
+            EventSet::empty()
+        });
+        let epoll_event = EpollEvent::new(event_set, event.data);
+
+        let instances = EPOLL_INSTANCES.lock().unwrap();
+        if let Some(epoll) = instances.get(&epoll_fd) {
+            debug!("Found epoll instance for fd: {}", epoll_fd);
+            let result = epoll.ctl(control_op, fd, epoll_event);
+            if let Err(ref e) = result {
+                error!("epoll.ctl failed: {:?}", e);
+            } else {
+                debug!("epoll.ctl succeeded");
+            }
+            result
+        } else {
+            error!("Epoll instance not found for fd: {}, available instances: {:?}",
+                   epoll_fd, instances.keys().collect::<Vec<_>>());
+            Err(std::io::Error::new(
+                std::io::ErrorKind::InvalidInput,
+                format!("Epoll instance not found for fd: {}", epoll_fd)
+            ))
+        }
+    }
+
+    pub fn wait(epoll_fd: RawFd, timeout: i32, events: &mut [Event]) -> std::io::Result<usize> {
+        debug!("epoll_wait: epoll_fd={}, timeout={}, max_events={}",
+               epoll_fd, timeout, events.len());
+
+        let mut epoll_events: Vec<EpollEvent> = vec![EpollEvent::default(); events.len()];
+
+        let instances = EPOLL_INSTANCES.lock().unwrap();
+        let num_events = if let Some(epoll) = instances.get(&epoll_fd) {
+            let result = epoll.wait(timeout, &mut epoll_events);
+            match result {
+                Ok(n) => {
+                    debug!("epoll_wait returned {} events", n);
+                    n
+                }
+                Err(ref e) => {
+                    error!("epoll_wait failed: {:?}", e);
+                    return Err(e.kind().into());
+                }
+            }
+        } else {
+            error!("Epoll instance not found for fd: {} during wait", epoll_fd);
+            return Err(std::io::Error::new(
+                std::io::ErrorKind::InvalidInput,
+                format!("Epoll instance not found for fd: {} during wait", epoll_fd)
+            ));
+        };
+
+        for i in 0..num_events {
+            events[i] = Event {
+                events: epoll_events[i].events(),
+                data: epoll_events[i].data(),
+            };
+            debug!("Event {}: events={}, data={}", i, events[i].events, events[i].data);
+        }
+
+        Ok(num_events)
+    }
+
+    pub fn close(epoll_fd: RawFd) {
+        debug!("Closing epoll instance: {}", epoll_fd);
+        let mut instances = EPOLL_INSTANCES.lock().unwrap();
+        if instances.remove(&epoll_fd).is_some() {
+            debug!("Removed epoll instance: {}", epoll_fd);
+        } else {
+            warn!("Attempted to close non-existent epoll instance: {}", epoll_fd);
+        }
+    }
+}
+
+#[derive(Debug, Copy, Clone)]
+pub enum ControlOptions {
+    Add = 1,
+    Delete = 2,
+    Modify = 3,
+}
+
 
