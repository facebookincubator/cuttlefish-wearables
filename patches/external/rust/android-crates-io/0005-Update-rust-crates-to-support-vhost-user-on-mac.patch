+        //         EventFilter::Read,
+        //         event_fd_1.as_raw_fd() as isize
+        //     )
+        //     .is_err());
+
+        let event_fd_2 = EventFd::new(0).unwrap();
+        event_fd_2.write(1).unwrap();
+        assert!(kq
+            .ctl(
+                ControlOperation::Add,
+                event_fd_2.as_raw_fd(),
