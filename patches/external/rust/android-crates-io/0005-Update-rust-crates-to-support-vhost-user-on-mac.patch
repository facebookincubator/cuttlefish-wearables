+        // Test kqueue wait behavior
+        let mut ready_events = vec![KqueueEvent::default(); EVENT_BUFFER_SIZE];
+        let ev_count = kq.wait(DEFAULT_TIMEOUT, &mut ready_events[..]).unwrap();
+
+        // We expect to have events ready
+        assert!(ev_count > 0);
+
+        // Test removing an fd from kqueue
