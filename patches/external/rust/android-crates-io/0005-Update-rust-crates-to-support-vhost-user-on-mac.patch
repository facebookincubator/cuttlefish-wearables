+// Copyright 2024 rust-vmm Authors or its affiliates. All Rights Reserved.
+// SPDX-License-Identifier: BSD-3-Clause
+
+//! macOS implementation of epoll using kqueue.
+
+use std::fmt::{Debug, Formatter, Result};
+use std::io::{self, Error};
+use std::os::unix::io::RawFd;
+
+use libc::{
+    kqueue, kevent, timespec, EV_ADD, EV_DELETE, EV_ENABLE, EV_DISABLE, EV_ONESHOT, EV_CLEAR,
+    EV_EOF, EV_ERROR, EVFILT_READ, EVFILT_WRITE,
+};
+
+// Define macOS equivalents for Linux epoll constants
+pub const EPOLL_CTL_ADD: i32 = 1;
+pub const EPOLL_CTL_MOD: i32 = 3;
+pub const EPOLL_CTL_DEL: i32 = 2;
+
+// Map Linux epoll events to macOS equivalents
+pub const EPOLLET: u32 = EV_CLEAR as u32;
+pub const EPOLLIN: u32 = 0x001;
+pub const EPOLLERR: u32 = EV_ERROR as u32;
+pub const EPOLLHUP: u32 = EV_EOF as u32;
+pub const EPOLLOUT: u32 = 0x004;
+pub const EPOLLPRI: u32 = 0x002;
+pub const EPOLLRDHUP: u32 = EV_EOF as u32;
+pub const EPOLLWAKEUP: u32 = 0x20000000;
+pub const EPOLLONESHOT: u32 = EV_ONESHOT as u32;
+pub const EPOLLEXCLUSIVE: u32 = 0x10000000;
+
+pub const EPOLL_CLOEXEC: i32 = 0x02000000;
+
+#[repr(i32)]
+#[allow(non_camel_case_types)]
+pub enum ControlOptions {
+    /// Indicates an addition to the interest list.
+    EPOLL_CTL_ADD = EPOLL_CTL_ADD,
+    /// Indicates a modification of flags for an interest already in list.
+    EPOLL_CTL_MOD = EPOLL_CTL_MOD,
+    /// Indicates a removal of an interest from the list.
+    EPOLL_CTL_DEL = EPOLL_CTL_DEL,
+}
+
+bitflags::bitflags! {
+    #[derive(Debug, Clone, Copy, PartialEq, Eq, PartialOrd, Ord, Hash)]
+    pub struct Events: u32 {
+        /// Sets the Edge Triggered behavior for the associated file descriptor.
+        const EPOLLET      = EPOLLET;
+        /// The associated file is available for read operations.
+        const EPOLLIN      = EPOLLIN;
+        /// Error condition happened on the associated file descriptor.
+        const EPOLLERR     = EPOLLERR;
+        /// Hang up happened on the associated file descriptor.
+        const EPOLLHUP     = EPOLLHUP;
+        /// The associated file is available for write operations.
+        const EPOLLOUT     = EPOLLOUT;
+        /// There is urgent data available for read operations.
+        const EPOLLPRI     = EPOLLPRI;
+        /// Stream socket peer closed connection, or shut down writing half of connection.
+        const EPOLLRDHUP   = EPOLLRDHUP;
+        /// Wakeup flag (not fully supported on macOS).
+        const EPOLLWAKEUP  = EPOLLWAKEUP;
+        /// Sets the one-shot behavior for the associated file descriptor.
+        const EPOLLONESHOT = EPOLLONESHOT;
+        /// Sets an exclusive wakeup mode (not fully supported on macOS).
+        const EPOLLEXCLUSIVE = EPOLLEXCLUSIVE;
+    }
+}
+
+/// 'libc::epoll_event' equivalent for macOS.
+#[repr(C)]
+#[cfg_attr(target_arch = "x86_64", repr(packed))]
+#[derive(Clone, Copy)]
+pub struct Event {
+    pub events: u32,
+    pub data: u64,
+}
+
+impl Event {
+    pub fn new(events: Events, data: u64) -> Event {
+        Event {
+            events: events.bits(),
+            data: data,
+        }
+    }
+}
+
+impl Debug for Event {
+    fn fmt(&self, f: &mut Formatter<'_>) -> Result {
+        let data = self.data;
+        f.debug_struct("Event")
+            .field("events", &Events::from_bits_retain(self.events))
+            .field("data", &data)
+            .finish()
+    }
+}
+
+/// Internal structure to manage kqueue state
+struct KqueueState {
+    kqueue_fd: RawFd,
+}
+
+impl KqueueState {
+    fn new() -> io::Result<Self> {
+        let kqueue_fd = unsafe { kqueue() };
+        if kqueue_fd < 0 {
+            return Err(Error::last_os_error());
+        }
+        Ok(KqueueState { kqueue_fd })
+    }
+}
+
+impl Drop for KqueueState {
+    fn drop(&mut self) {
+        unsafe {
+            libc::close(self.kqueue_fd);
+        }
+    }
+}
+
+// Global kqueue instance (simplified approach)
+static mut KQUEUE_STATE: Option<KqueueState> = None;
+static mut KQUEUE_INIT: std::sync::Once = std::sync::Once::new();
+
+fn get_kqueue_fd() -> io::Result<RawFd> {
+    unsafe {
+        KQUEUE_INIT.call_once(|| {
+            KQUEUE_STATE = KqueueState::new().ok();
+        });
+        
+        match &KQUEUE_STATE {
+            Some(state) => Ok(state.kqueue_fd),
+            None => Err(Error::new(io::ErrorKind::Other, "Failed to initialize kqueue")),
+        }
+    }
+}
+
+/// Creates a new epoll file descriptor (returns kqueue fd on macOS).
+pub fn create(cloexec: bool) -> io::Result<RawFd> {
+    let kq_fd = unsafe { kqueue() };
+    if kq_fd < 0 {
+        return Err(Error::last_os_error());
+    }
+    
+    if cloexec {
+        let flags = unsafe { libc::fcntl(kq_fd, libc::F_GETFD) };
+        if flags >= 0 {
+            unsafe { libc::fcntl(kq_fd, libc::F_SETFD, flags | libc::FD_CLOEXEC) };
+        }
+    }
+    
+    Ok(kq_fd)
+}
+
+/// Safe wrapper for kqueue control operations (epoll_ctl equivalent)
+pub fn ctl(
+    epfd: RawFd,
+    op: ControlOptions,
+    fd: RawFd,
+    event: Event,
+) -> io::Result<()> {
+    let mut kev = kevent {
+        ident: fd as usize,
+        filter: 0,
+        flags: 0,
+        fflags: 0,
+        data: 0,
+        udata: std::ptr::null_mut(),
+    };
+
+    // Map epoll events to kqueue filters and flags
+    if event.events & EPOLLIN != 0 {
+        kev.filter = EVFILT_READ;
+    } else if event.events & EPOLLOUT != 0 {
+        kev.filter = EVFILT_WRITE;
+    } else {
+        kev.filter = EVFILT_READ; // Default to read
+    }
+
+    match op {
+        ControlOptions::EPOLL_CTL_ADD => {
+            kev.flags = EV_ADD as u16;
+            if event.events & EPOLLONESHOT != 0 {
+                kev.flags |= EV_ONESHOT as u16;
+            }
+            if event.events & EPOLLET != 0 {
+                kev.flags |= EV_CLEAR as u16;
+            }
+        }
+        ControlOptions::EPOLL_CTL_MOD => {
+            kev.flags = EV_ADD as u16; // Modify is similar to add in kqueue
+        }
+        ControlOptions::EPOLL_CTL_DEL => {
+            kev.flags = EV_DELETE as u16;
+        }
+    }
+
+    kev.udata = event.data as *mut libc::c_void;
+
+    let changelist = [kev];
+    let result = unsafe {
+        kevent(
+            epfd,
+            changelist.as_ptr(),
+            1,
+            std::ptr::null_mut(),
+            0,
+            std::ptr::null(),
+        )
+    };
+
+    if result < 0 {
+        Err(Error::last_os_error())
+    } else {
+        Ok(())
+    }
+}
+
+/// Safe wrapper for kqueue wait (epoll_wait equivalent)
+pub fn wait(epfd: RawFd, timeout: i32, buf: &mut [Event]) -> io::Result<usize> {
+    let timeout_spec = if timeout < 0 {
+        std::ptr::null()
+    } else {
+        &timespec {
+            tv_sec: (timeout / 1000) as libc::time_t,
+            tv_nsec: ((timeout % 1000) * 1_000_000) as libc::c_long,
+        }
+    };
+
+    // Create a buffer for kqueue events
+    let mut kevents: Vec<kevent> = vec![
+        kevent {
+            ident: 0,
+            filter: 0,
+            flags: 0,
+            fflags: 0,
+            data: 0,
+            udata: std::ptr::null_mut(),
+        };
+        buf.len()
+    ];
+
+    let num_events = unsafe {
+        kevent(
+            epfd,
+            std::ptr::null(),
+            0,
+            kevents.as_mut_ptr(),
+            buf.len() as i32,
+            timeout_spec,
+        )
+    };
+
+    if num_events < 0 {
+        return Err(Error::last_os_error());
+    }
+
+    // Convert kqueue events back to epoll events
+    for i in 0..(num_events as usize) {
+        let kev = &kevents[i];
+        let mut events = 0u32;
+
+        if kev.filter == EVFILT_READ {
+            events |= EPOLLIN;
+        }
+        if kev.filter == EVFILT_WRITE {
+            events |= EPOLLOUT;
+        }
+        if kev.flags & (EV_EOF as u16) != 0 {
+            events |= EPOLLHUP;
+        }
+        if kev.flags & (EV_ERROR as u16) != 0 {
+            events |= EPOLLERR;
+        }
+
+        buf[i] = Event {
+            events,
+            data: kev.udata as u64,
+        };
+    }
+
+    Ok(num_events as usize)
+}
+
+/// Safe wrapper for close
+pub fn close(epfd: RawFd) -> io::Result<()> {
+    let result = unsafe { libc::close(epfd) };
+    if result < 0 {
+        Err(Error::last_os_error())
+    } else {
+        Ok(())
+    }
+}
+
+fn cvt(result: libc::c_int) -> io::Result<libc::c_int> {
+    if result < 0 {
+        Err(Error::last_os_error())
+    } else {
+        Ok(result)
+    }
+}
