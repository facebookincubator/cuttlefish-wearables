+// Copyright 2024 rust-vmm Authors or its affiliates. All Rights Reserved.
+// SPDX-License-Identifier: BSD-3-Clause
+
+//! macOS implementation of epoll-like functionality using kqueue.
+//! 
+//! This provides a kqueue-based implementation that offers similar
+//! functionality to Linux epoll for event-driven I/O multiplexing.
+
+use std::io;
+use std::ops::{Deref, Drop};
+use std::os::unix::io::{AsRawFd, RawFd};
+
+use bitflags::bitflags;
+use libc::{
+    kqueue, kevent, timespec, EV_ADD, EV_DELETE, EV_ENABLE, EV_DISABLE, EV_ONESHOT, EV_CLEAR,
+    EV_EOF, EV_ERROR, EVFILT_READ, EVFILT_WRITE,
+};
+
+use crate::syscall::SyscallReturnCode;
+
+/// Wrapper over kqueue filter types that can be monitored.
+#[derive(Debug)]
+#[repr(i16)]
+pub enum EventFilter {
+    /// Monitor for read availability.
+    Read = EVFILT_READ,
+    /// Monitor for write availability.
+    Write = EVFILT_WRITE,
+}
+
+bitflags! {
+    /// The type of events and flags we can set for kqueue.
+    pub struct EventFlags: u16 {
+        /// Add the event to the kqueue.
+        const ADD = EV_ADD as u16;
+        /// Remove the event from the kqueue.
+        const DELETE = EV_DELETE as u16;
+        /// Enable the event.
+        const ENABLE = EV_ENABLE as u16;
+        /// Disable the event.
+        const DISABLE = EV_DISABLE as u16;
+        /// Remove the event after it triggers once.
+        const ONESHOT = EV_ONESHOT as u16;
+        /// Clear the event state after reporting.
+        const CLEAR = EV_CLEAR as u16;
+        /// End-of-file condition.
+        const EOF = EV_EOF as u16;
+        /// Error condition.
+        const ERROR = EV_ERROR as u16;
+    }
+}
+
+/// Wrapper over kqueue control operations.
+#[derive(Debug)]
+#[repr(i32)]
+pub enum ControlOperation {
+    /// Add a file descriptor to the interest list.
+    Add,
+    /// Modify the settings associated with a file descriptor.
+    Modify,
+    /// Remove a file descriptor from the interest list.
+    Delete,
+}
+
+/// Wrapper over `libc::kevent`.
+#[repr(transparent)]
+#[derive(Clone, Copy)]
+pub struct KqueueEvent(kevent);
+
+impl std::fmt::Debug for KqueueEvent {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        write!(
+            f,
+            "{{ ident: {}, filter: {}, flags: {}, data: {} }}",
+            self.ident(),
+            self.filter(),
+            self.flags(),
+            self.data()
+        )
+    }
+}
+
+impl Deref for KqueueEvent {
+    type Target = kevent;
+    fn deref(&self) -> &Self::Target {
+        &self.0
+    }
+}
+
+impl Default for KqueueEvent {
+    fn default() -> Self {
+        KqueueEvent(kevent {
+            ident: 0,
+            filter: 0,
+            flags: 0,
+            fflags: 0,
+            data: 0,
+            udata: std::ptr::null_mut(),
+        })
+    }
+}
+
+impl KqueueEvent {
+    /// Create a new kevent instance.
+    ///
+    /// # Arguments
+    ///
+    /// * `ident` - identifier for this event (usually a file descriptor)
+    /// * `filter` - the kernel filter to apply
+    /// * `flags` - action flags for the event
+    /// * `data` - filter-specific data
+    ///
+    /// # Examples
+    ///
+    /// ```
+    /// extern crate vmm_sys_util;
+    /// use vmm_sys_util::kqueue::{KqueueEvent, EventFilter, EventFlags};
+    ///
+    /// let event = KqueueEvent::new(2, EventFilter::Read, EventFlags::ADD | EventFlags::ENABLE, 0);
+    /// ```
+    pub fn new(ident: usize, filter: EventFilter, flags: EventFlags, data: isize) -> Self {
+        KqueueEvent(kevent {
+            ident,
+            filter: filter as i16,
+            flags: flags.bits(),
+            fflags: 0,
+            data,
+            udata: std::ptr::null_mut(),
+        })
+    }
+
+    /// Returns the identifier from the kevent.
+    ///
+    /// # Examples
+    ///
+    /// ```
+    /// extern crate vmm_sys_util;
+    /// use vmm_sys_util::kqueue::{KqueueEvent, EventFilter, EventFlags};
+    ///
+    /// let event = KqueueEvent::new(2, EventFilter::Read, EventFlags::ADD, 0);
+    /// assert_eq!(event.ident(), 2);
+    /// ```
+    pub fn ident(&self) -> usize {
+        self.ident
+    }
+
+    /// Returns the filter from the kevent.
+    ///
+    /// # Examples
+    ///
+    /// ```
+    /// extern crate vmm_sys_util;
+    /// use vmm_sys_util::kqueue::{KqueueEvent, EventFilter, EventFlags};
+    ///
+    /// let event = KqueueEvent::new(2, EventFilter::Read, EventFlags::ADD, 0);
+    /// assert_eq!(event.filter(), EVFILT_READ);
+    /// ```
+    pub fn filter(&self) -> i16 {
+        self.filter
+    }
+
+    /// Returns the flags from the kevent.
+    ///
+    /// # Examples
+    ///
+    /// ```
+    /// extern crate vmm_sys_util;
+    /// use vmm_sys_util::kqueue::{KqueueEvent, EventFilter, EventFlags};
+    ///
+    /// let event = KqueueEvent::new(2, EventFilter::Read, EventFlags::ADD, 0);
+    /// assert_eq!(event.flags(), EV_ADD as u16);
+    /// ```
+    pub fn flags(&self) -> u16 {
+        self.flags
+    }
+
+    /// Returns the data from the kevent.
+    ///
+    /// # Examples
+    ///
+    /// ```
+    /// extern crate vmm_sys_util;
+    /// use vmm_sys_util::kqueue::{KqueueEvent, EventFilter, EventFlags};
+    ///
+    /// let event = KqueueEvent::new(2, EventFilter::Read, EventFlags::ADD, 42);
+    /// assert_eq!(event.data(), 42);
+    /// ```
+    pub fn data(&self) -> isize {
+        self.data
+    }
+
+    /// Converts the kevent identifier to a RawFd.
+    ///
+    /// This conversion is lossy when the identifier does not correspond to a RawFd.
+    ///
+    /// # Examples
+    ///
+    /// ```
+    /// extern crate vmm_sys_util;
+    /// use vmm_sys_util::kqueue::{KqueueEvent, EventFilter, EventFlags};
+    ///
+    /// let event = KqueueEvent::new(2, EventFilter::Read, EventFlags::ADD, 0);
+    /// assert_eq!(event.fd(), 2);
+    /// ```
+    pub fn fd(&self) -> RawFd {
+        self.ident as i32
+    }
+}
+
+/// Wrapper over kqueue functionality.
+#[derive(Debug)]
+pub struct Kqueue {
+    kqueue_fd: RawFd,
+}
+
+impl Kqueue {
+    /// Create a new kqueue file descriptor.
+    pub fn new() -> io::Result<Self> {
+        let kqueue_fd = SyscallReturnCode(
+            // SAFETY: Safe because the return code is transformed by `into_result` in a `Result`.
+            unsafe { kqueue() },
+        )
+        .into_result()?;
+        Ok(Kqueue { kqueue_fd })
+    }
+
+    /// Wrapper for `libc::kevent` for control operations.
+    ///
+    /// This can be used for adding, modifying or removing a file descriptor in the
+    /// interest list of the kqueue instance.
+    ///
+    /// # Arguments
+    ///
+    /// * `operation` - refers to the action to be performed on the file descriptor.
+    /// * `fd` - the file descriptor on which we want to perform `operation`.
+    /// * `filter` - the filter type to monitor.
+    /// * `data` - optional data associated with the event.
+    ///
+    /// # Examples
+    ///
+    /// ```
+    /// extern crate vmm_sys_util;
+    ///
+    /// use std::os::unix::io::AsRawFd;
+    /// use vmm_sys_util::kqueue::{ControlOperation, Kqueue, EventFilter};
+    /// use vmm_sys_util::eventfd::EventFd;
+    ///
+    /// let kq = Kqueue::new().unwrap();
+    /// let event_fd = EventFd::new(0).unwrap();
+    /// kq.ctl(
+    ///     ControlOperation::Add,
+    ///     event_fd.as_raw_fd(),
+    ///     EventFilter::Read,
+    ///     0,
+    /// ).unwrap();
+    /// ```
+    pub fn ctl(
+        &self,
+        operation: ControlOperation,
+        fd: RawFd,
+        filter: EventFilter,
+        data: isize,
+    ) -> io::Result<()> {
+        let flags = match operation {
+            ControlOperation::Add => EventFlags::ADD | EventFlags::ENABLE,
+            ControlOperation::Modify => EventFlags::ENABLE,
+            ControlOperation::Delete => EventFlags::DELETE,
+        };
+
+        let event = KqueueEvent::new(fd as usize, filter, flags, data);
+        let changelist = [event.0];
+
+        SyscallReturnCode(
+            // SAFETY: Safe because we give a valid kqueue file descriptor and a valid kevent
+            // structure. We also check the return value.
+            unsafe {
+                kevent(
+                    self.kqueue_fd,
+                    changelist.as_ptr(),
+                    1,
+                    std::ptr::null_mut(),
+                    0,
+                    std::ptr::null(),
+                )
+            },
+        )
+        .into_empty_result()
+    }
+
+    /// Wrapper for `libc::kevent` for waiting on events.
+    /// Returns the number of file descriptors in the interest list that became ready
+    /// for I/O or `errno` if an error occurred.
+    ///
+    /// # Arguments
+    ///
+    /// * `timeout_ms` - specifies for how long the `kevent` system call will block
+    ///                  (measured in milliseconds). -1 means block indefinitely.
+    /// * `events` - points to a memory area that will be used for storing the events
+    ///              returned by `kevent()` call.
+    ///
+    /// # Examples
+    ///
+    /// ```
+    /// extern crate vmm_sys_util;
+    ///
+    /// use std::os::unix::io::AsRawFd;
+    /// use vmm_sys_util::kqueue::{ControlOperation, Kqueue, KqueueEvent, EventFilter};
+    /// use vmm_sys_util::eventfd::EventFd;
+    ///
+    /// let kq = Kqueue::new().unwrap();
+    /// let event_fd = EventFd::new(0).unwrap();
+    ///
+    /// let mut ready_events = vec![KqueueEvent::default(); 10];
+    /// kq.ctl(
+    ///     ControlOperation::Add,
+    ///     event_fd.as_raw_fd(),
+    ///     EventFilter::Write,
+    ///     0,
+    /// ).unwrap();
+    /// let ev_count = kq.wait(1000, &mut ready_events[..]).unwrap();
+    /// assert_eq!(ev_count, 1);
+    /// ```
+    pub fn wait(&self, timeout_ms: i32, events: &mut [KqueueEvent]) -> io::Result<usize> {
+        let timeout = if timeout_ms < 0 {
+            std::ptr::null()
+        } else {
+            &timespec {
+                tv_sec: (timeout_ms / 1000) as libc::time_t,
+                tv_nsec: ((timeout_ms % 1000) * 1_000_000) as libc::c_long,
+            }
+        };
+
+        let events_count = SyscallReturnCode(
+            // SAFETY: Safe because we give a valid kqueue file descriptor and an array of
+            // kevent structures that will be modified by the kernel to indicate information
+            // about the subset of file descriptors in the interest list.
+            // We also check the return value.
+            unsafe {
+                kevent(
+                    self.kqueue_fd,
+                    std::ptr::null(),
+                    0,
+                    events.as_mut_ptr() as *mut kevent,
+                    events.len() as i32,
+                    timeout,
+                )
+            },
+        )
+        .into_result()? as usize;
+
+        Ok(events_count)
+    }
+}
+
+impl AsRawFd for Kqueue {
+    fn as_raw_fd(&self) -> RawFd {
+        self.kqueue_fd
+    }
+}
+
+impl Drop for Kqueue {
+    fn drop(&mut self) {
+        // SAFETY: Safe because this fd is opened with `kqueue` and we trust
+        // the kernel to give us a valid fd.
+        unsafe {
+            libc::close(self.kqueue_fd);
+        }
+    }
+}
+
