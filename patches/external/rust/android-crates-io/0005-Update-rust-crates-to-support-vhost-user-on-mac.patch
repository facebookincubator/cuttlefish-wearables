+        event = KqueueEvent::new(2, EventFilter::Read, EventFlags::ADD, 42);
+        assert_eq!(event.ident(), 2);
+        assert_eq!(event.filter(), EVFILT_READ);
+        assert_eq!(event.data(), 42);
+        assert_eq!(event.fd(), 2);
+    }
+
+    #[test]
+    fn test_events_debug() {
+        let event = KqueueEvent::new(42, EventFilter::Read, EventFlags::ADD, 123);
+        let debug_str = format!("{:?}", event);
+        assert!(debug_str.contains("ident: 42"));
+        assert!(debug_str.contains("data: 123"));
+    }
+
+    #[test]
+    fn test_kqueue() {
+        const DEFAULT_TIMEOUT: i32 = 250;
+        const EVENT_BUFFER_SIZE: usize = 128;
+
+        let kq = Kqueue::new().unwrap();
+        assert_eq!(kq.kqueue_fd, kq.as_raw_fd());
+
+        // Test different scenarios for kqueue control and wait functionality.
+        let event_fd_1 = EventFd::new(0).unwrap();
+        // Write to make it available for reading
+        event_fd_1.write(1).unwrap();
+
+        // Add the fd to kqueue for read monitoring
+        assert!(kq
+            .ctl(
+                ControlOperation::Add,
+                event_fd_1.as_raw_fd(),
+                EventFilter::Read,
+                event_fd_1.as_raw_fd() as isize
+            )
