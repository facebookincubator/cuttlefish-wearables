+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::os::unix::net::UnixStream;
+    use log::info;
+
+    #[test]
+    fn test_scm_socket_basic() {
+        let (sock1, sock2) = UnixStream::pair().unwrap();
+
+        // Test sending data without file descriptors
+        let data = b"hello";
+        let iovs = [data.as_slice()];
+        let sent = sock1.send_with_fds(&iovs, &[]).unwrap();
+        assert_eq!(sent, 5);
+
+        // Test receiving data without file descriptors
+        let mut buf = [0u8; 10];
+        let mut recv_iovs = [libc::iovec {
+            iov_base: buf.as_mut_ptr() as *mut libc::c_void,
+            iov_len: buf.len(),
+        }];
+        let mut recv_fds = [0; 1];
+        let (received, fd_count) = sock2.recv_with_fds(&mut recv_iovs, &mut recv_fds).unwrap();
+        assert_eq!(received, 5);
+        assert_eq!(fd_count, 0);
+        assert_eq!(&buf[..5], b"hello");
+    }
+
+    #[test]
+    fn test_scm_socket_with_fds() {
+        // Initialize the logger for this test
+        info!("Starting test_scm_socket_with_fds");
+
+        let (sock1, sock2) = UnixStream::pair().unwrap();
+
+        // Create a pipe to send as file descriptor
+        let mut pipe_fds = [0i32; 2];
+        unsafe { libc::pipe(pipe_fds.as_mut_ptr()) };
+
+        let data = b"test";
+        let iovs = [data.as_slice()];
+        let send_fds = [pipe_fds[0]];
+
+        // Send data with file descriptor
+        let sent = sock1.send_with_fds(&iovs, &send_fds).unwrap();
+        assert_eq!(sent, 4);
+
+        // Receive data with file descriptor
+        let mut buf = [0u8; 10];
+        let mut recv_iovs = [libc::iovec {
+            iov_base: buf.as_mut_ptr() as *mut libc::c_void,
+            iov_len: buf.len(),
+        }];
+        let mut recv_fds = [0; 1];
+        let (received, fd_count) = sock2.recv_with_fds(&mut recv_iovs, &mut recv_fds).unwrap();
+
+        assert_eq!(received, 4);
+        assert_eq!(fd_count, 1);
+        assert_eq!(&buf[..4], b"test");
+        assert!(recv_fds[0] > 0); // Should have received a valid fd
+
+        // Clean up
+        unsafe {
+            libc::close(pipe_fds[0]);
+            libc::close(pipe_fds[1]);
+            libc::close(recv_fds[0]);
+        }
+    }
