@@ -0,0 +1,180 @@
+use std::io;
+use std::mem;
+use std::os::unix::io::{AsRawFd, RawFd};
+use std::os::unix::net::UnixStream;
+use std::ptr;
+use log::{debug, info, trace};
+
+/// Extension trait for UnixStream to add file descriptor sending/receiving capabilities
+pub trait ScmSocket {
+    /// Send data with file descriptors over a Unix domain socket
+    fn send_with_fds(&self, iovs: &[&[u8]], fds: &[RawFd]) -> Result<usize, crate::errno::Error>;
+
+    /// Receive data with file descriptors from a Unix domain socket
+    fn recv_with_fds(&self, iovs: &mut [libc::iovec], fds: &mut [RawFd]) -> Result<(usize, usize), crate::errno::Error>;
+}
+
+impl ScmSocket for UnixStream {
+    fn send_with_fds(&self, iovs: &[&[u8]], fds: &[RawFd]) -> Result<usize, crate::errno::Error> {
+        let socket_fd = self.as_raw_fd();
+
+        // Convert iovs to iovec structures
+        let mut iov_vec: Vec<libc::iovec> = iovs
+            .iter()
+            .map(|buf| libc::iovec {
+                iov_base: buf.as_ptr() as *mut libc::c_void,
+                iov_len: buf.len(),
+            })
+            .collect();
+
+        // Prepare control message buffer for file descriptors
+        let cmsg_len = unsafe { libc::CMSG_SPACE(mem::size_of_val(fds) as u32) as usize };
+        let mut cmsg_buf = vec![0u8; cmsg_len];
+
+        let mut msg: libc::msghdr = unsafe { mem::zeroed() };
+        msg.msg_iov = iov_vec.as_mut_ptr();
+        msg.msg_iovlen = iov_vec.len() as _;
+
+        if !fds.is_empty() {
+            msg.msg_control = cmsg_buf.as_mut_ptr() as *mut libc::c_void;
+            msg.msg_controllen = cmsg_len as _;
+
+            let cmsg = unsafe { libc::CMSG_FIRSTHDR(&msg) };
+            if !cmsg.is_null() {
+                unsafe {
+                    (*cmsg).cmsg_level = libc::SOL_SOCKET;
+                    (*cmsg).cmsg_type = libc::SCM_RIGHTS;
+                    (*cmsg).cmsg_len = libc::CMSG_LEN(mem::size_of_val(fds) as u32) as _;
+
+                    let data_ptr = libc::CMSG_DATA(cmsg) as *mut RawFd;
+                    ptr::copy_nonoverlapping(fds.as_ptr(), data_ptr, fds.len());
+                }
+            }
+        }
+
+        let result = unsafe { libc::sendmsg(socket_fd, &msg, 0) };
+        if result == -1 {
+            Err(crate::errno::Error::last())
+        } else {
+            Ok(result as usize)
+        }
+    }
+
+    fn recv_with_fds(&self, iovs: &mut [libc::iovec], fds: &mut [RawFd]) -> Result<(usize, usize), crate::errno::Error> {
+        info!("File: sock_ctrl_msg.rs, Function: recv_with_fds, Line: 69");
+        let socket_fd = self.as_raw_fd();
+
+        // Prepare control message buffer for file descriptors
+        let cmsg_len = unsafe { libc::CMSG_SPACE((fds.len() * mem::size_of::<RawFd>()) as u32) as usize };
+        let mut cmsg_buf = vec![0u8; cmsg_len];
+
+        let mut msg: libc::msghdr = unsafe { mem::zeroed() };
+        msg.msg_iov = iovs.as_mut_ptr();
+        msg.msg_iovlen = iovs.len() as _;
+        msg.msg_control = cmsg_buf.as_mut_ptr() as *mut libc::c_void;
+        msg.msg_controllen = cmsg_len as _;
+        debug!("sock_ctrl_msg.rs, recv Message: {:?}", msg);
+        let result = unsafe { libc::recvmsg(socket_fd, &mut msg, 0) };
+        info!("File: sock_ctrl_msg.rs, Function: recv_with_fds, Result: {}", result);
+        if result == -1 {
+            return Err(crate::errno::Error::last());
+        }
+        // Log the function call with file name, function name, and result using a custom logging function
+
+
+
+        let bytes_received = result as usize;
+        let mut fds_received = 0;
+
+        // Extract file descriptors from control message
+        let mut cmsg = unsafe { libc::CMSG_FIRSTHDR(&msg) };
+        while !cmsg.is_null() {
+            trace!("sock_ctrl_msg.rs, extract fd from cmsg {:?}", cmsg);
+            unsafe {
+                if (*cmsg).cmsg_level == libc::SOL_SOCKET && (*cmsg).cmsg_type == libc::SCM_RIGHTS {
+                    let data_ptr = libc::CMSG_DATA(cmsg) as *const RawFd;
+                    let fd_count = ((*cmsg).cmsg_len as usize - libc::CMSG_LEN(0) as usize) / mem::size_of::<RawFd>();
+                    let copy_count = std::cmp::min(fd_count, fds.len());
+
+                    ptr::copy_nonoverlapping(data_ptr, fds.as_mut_ptr(), copy_count);
+                    fds_received = copy_count;
+                    break;
+                }
+                cmsg = libc::CMSG_NXTHDR(&msg, cmsg);
+            }
+        }
+
+        Ok((bytes_received, fds_received))
+    }
+}
