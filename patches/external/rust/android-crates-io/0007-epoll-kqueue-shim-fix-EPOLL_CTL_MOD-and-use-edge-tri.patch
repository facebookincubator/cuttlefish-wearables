 crates/epoll/src/macos.rs | 47 ++++++++++++++++++++++++++++++++++-----
 1 file changed, 41 insertions(+), 6 deletions(-)

diff --git a/crates/epoll/src/macos.rs b/crates/epoll/src/macos.rs
index 79e31659..9522d641 100644
--- a/crates/epoll/src/macos.rs
+++ b/crates/epoll/src/macos.rs
@@ -163,18 +163,53 @@ pub fn ctl(
     // Determine base flags based on operation
     let base_flags: u16 = match op {
         ControlOptions::EPOLL_CTL_ADD => {
-            let mut flags = EV_ADD as u16;
+            // Always use EV_CLEAR (edge-triggered) on macOS. Linux epoll is
+            // level-triggered by default, but kqueue level-triggered behavior
+            // on listener sockets causes spin loops because it re-fires on
+            // every kevent() call while connections are pending. EV_CLEAR
+            // makes kqueue report each new event only once, which matches
+            // the expected behavior of the daemon's epoll usage pattern.
+            let mut flags = (EV_ADD | EV_CLEAR) as u16;
             if event.events & EPOLLONESHOT != 0 {
                 flags |= EV_ONESHOT as u16;
             }
-            if event.events & EPOLLET != 0 {
-                flags |= EV_CLEAR as u16;
-            }
             flags
         }
         ControlOptions::EPOLL_CTL_MOD => {
-            // Modify is similar to add in kqueue
-            EV_ADD as u16
+            // kqueue has separate filters for read/write, so modifying the
+            // event set requires deleting both existing filters first, then
+            // re-adding only the requested ones. Without this, stale filters
+            // (e.g. EVFILT_WRITE) remain registered and cause spurious events.
+            let del_events = [
+                kevent {
+                    ident: fd as usize,
+                    filter: EVFILT_READ,
+                    flags: EV_DELETE as u16,
+                    fflags: 0,
+                    data: 0,
+                    udata: std::ptr::null_mut(),
+                },
+                kevent {
+                    ident: fd as usize,
+                    filter: EVFILT_WRITE,
+                    flags: EV_DELETE as u16,
+                    fflags: 0,
+                    data: 0,
+                    udata: std::ptr::null_mut(),
+                },
+            ];
+            // Ignore errors — the filter may not have been registered.
+            unsafe {
+                kevent(
+                    epfd,
+                    del_events.as_ptr(),
+                    del_events.len() as i32,
+                    std::ptr::null_mut(),
+                    0,
+                    std::ptr::null(),
+                );
+            }
+            (EV_ADD | EV_CLEAR) as u16
         }
         ControlOptions::EPOLL_CTL_DEL => {
             EV_DELETE as u16
