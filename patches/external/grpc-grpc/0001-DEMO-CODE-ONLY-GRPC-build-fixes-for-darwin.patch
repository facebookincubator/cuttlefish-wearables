-#include "src/core/ext/transport/binder/client/endpoint_binder_pool.h"
-
 #ifndef GRPC_NO_BINDER
 
+#include "src/core/ext/transport/binder/client/endpoint_binder_pool.h"
+
 #include "src/core/ext/transport/binder/client/jni_utils.h"
 
