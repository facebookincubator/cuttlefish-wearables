diff --git a/libselinux/src/fgetfilecon.c b/libselinux/src/fgetfilecon.c
index d7051171..4c1c769a 100644
--- a/libselinux/src/fgetfilecon.c
+++ b/libselinux/src/fgetfilecon.c
@@ -12,21 +12,35 @@ static ssize_t fgetxattr_wrapper(int fd, const char *name, void *value, size_t s
 	char buf[40];
 	int fd_flag, saved_errno = errno;
 	ssize_t ret;
-
+#ifdef __APPLE__
+	ret = fgetxattr(fd, name, value, size, 0, 0);
+#else
 	ret = fgetxattr(fd, name, value, size);
+#endif
 	if (ret != -1 || errno != EBADF)
 		return ret;
 
 	/* Emulate O_PATH support */
 	fd_flag = fcntl(fd, F_GETFL);
+#ifdef __APPLE__
+	if (fd_flag == -1) {
+		errno = EBADF;
+		return -1;
+	}
+#else
 	if (fd_flag == -1 || (fd_flag & O_PATH) == 0) {
 		errno = EBADF;
 		return -1;
 	}
+#endif
 
 	snprintf(buf, sizeof(buf), "/proc/self/fd/%d", fd);
 	errno = saved_errno;
+#ifdef __APPLE__
+	ret = getxattr(buf, name, value, size, 0, 0);
+#else
 	ret = getxattr(buf, name, value, size);
+#endif
 	if (ret < 0 && errno == ENOENT)
 		errno = EBADF;
 	return ret;
diff --git a/libselinux/src/fsetfilecon.c b/libselinux/src/fsetfilecon.c
index 19ea15b7..8fa8ee6b 100644
--- a/libselinux/src/fsetfilecon.c
+++ b/libselinux/src/fsetfilecon.c
@@ -12,20 +12,35 @@ static int fsetxattr_wrapper(int fd, const char* name, const void* value, size_t
 	char buf[40];
 	int rc, fd_flag, saved_errno = errno;
 
+#ifdef __APPLE__
+	rc = fsetxattr(fd, name, value, size, flags, 0);
+#else
 	rc = fsetxattr(fd, name, value, size, flags);
+#endif
 	if (rc == 0 || errno != EBADF)
 		return rc;
 
 	/* Emulate O_PATH support */
 	fd_flag = fcntl(fd, F_GETFL);
+#ifdef __APPLE__
+	if (fd_flag == -1) {
+		errno = EBADF;
+		return -1;
+	}
+#else
 	if (fd_flag == -1 || (fd_flag & O_PATH) == 0) {
 		errno = EBADF;
 		return -1;
 	}
+#endif
 
 	snprintf(buf, sizeof(buf), "/proc/self/fd/%d", fd);
 	errno = saved_errno;
+#ifdef __APPLE__
+	rc = setxattr(buf, name, value, size, flags, 0);
+#else
 	rc = setxattr(buf, name, value, size, flags);
+#endif
 	if (rc < 0 && errno == ENOENT)
 		errno = EBADF;
 	return rc;
