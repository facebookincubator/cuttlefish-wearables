index 439da417..d1d0b1ee 100644
--- a/libselinux/src/init.c
+++ b/libselinux/src/init.c
@@ -5,10 +5,14 @@
 #include <errno.h>
 #include <ctype.h>
 #include <stdio.h>
+#ifndef __APPLE__
 #include <stdio_ext.h>
+#include <sys/vfs.h>
+#else
+#include <sys/mount.h>
+#endif
 #include <dlfcn.h>
 #include <sys/statvfs.h>
-#include <sys/vfs.h>
 #include <stdint.h>
 #include <limits.h>
 
@@ -54,6 +58,7 @@ static int verify_selinuxmnt(const char *mnt)
 
 int selinuxfs_exists(void)
 {
+#ifndef __APPLE__
 	int exists = 0;
 	FILE *fp = NULL;
 	char *buf = NULL;
@@ -77,10 +82,28 @@ int selinuxfs_exists(void)
 	free(buf);
 	fclose(fp);
 	return exists;
+#else
+	int exists = 0;
+    struct statfs *mounts;
+    int num_mounts, i;
+
+    num_mounts = getmntinfo(&mounts, MNT_NOWAIT);
+    if (num_mounts == 0)
+        return 1; /* Fail as if it exists */
+
+    for (i = 0; i < num_mounts; i++) {
+        if (strcmp(mounts[i].f_fstypename, "selinuxfs") == 0) {
+            exists = 1;
+            break;
+        }
+    }
+    return exists;
+#endif
 }
 
 static void init_selinuxmnt(void)
 {
+#ifndef __APPLE__
 	char *buf = NULL, *p;
 	FILE *fp = NULL;
 	size_t len;
@@ -128,6 +151,34 @@ static void init_selinuxmnt(void)
 	if (fp)
 		fclose(fp);
 	return;
+#else
+	struct statfs *mounts;
+    int num_mounts, i;
+
+    if (selinux_mnt)
+        return;
+
+    if (verify_selinuxmnt(SELINUXMNT) == 0) return;
+
+    if (verify_selinuxmnt(OLDSELINUXMNT) == 0) return;
+
+    /* Drop back to detecting it the long way. */
+    if (!selinuxfs_exists())
+        return;
+
+    /* At this point, the usual spot doesn't have an selinuxfs so
+     * we look around for it */
+    num_mounts = getmntinfo(&mounts, MNT_NOWAIT);
+    if (num_mounts == 0)
+        return;
+
+    for (i = 0; i < num_mounts; i++) {
+        if (strcmp(mounts[i].f_fstypename, "selinuxfs") == 0) {
+            verify_selinuxmnt(mounts[i].f_mntonname);
+            break;
+        }
+    }
+#endif
 }
 
 void fini_selinuxmnt(void)
