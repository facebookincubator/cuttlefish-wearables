From 4bd6252ad6820ad78e58fd1323e8e1bb4daed5f7 Mon Sep 17 00:00:00 2001
From: Alex Chong <achong@meta.com>
Date: Mon, 4 Aug 2025 09:44:34 -0700
Subject: [PATCH 2/2] additional changes for darwin support - swiftshader

Summary:
# Motivation:
This is required by cuttlefish host binaries

# Overview:
- support building on mac

Test Plan:
```
. build/envsetup.sh
 lunch aosp_cf_arm64_phone-userdebug
 m out/host/darwin-x86/cvd-host_package.tar.gz -k &> ~/build.logs.txt
```

Rollback Plan:

Reviewers: tcare, #cuttlefish-cross-platform, benthomas

Reviewed By: tcare

Subscribers: ryanyu, <internal-group>

Differential Revision: https://phabricator.intern.facebook.com/D79567427

Tags: aarch64
---
 src/Android.bp   | 17 +++++++++++------
 src/commit_id.py |  2 +-
 2 files changed, 12 insertions(+), 7 deletions(-)

diff --git a/src/Android.bp b/src/Android.bp
index 3d56a27d4..1b5641138 100644
--- a/src/Android.bp
+++ b/src/Android.bp
@@ -107,12 +107,6 @@ cc_defaults {
         "-Wno-non-virtual-dtor",
     ],
 
-    ldflags: [
-        // -Bsymbolic binds symbol references to their global definitions within
-        // a shared object, thereby preventing symbol preemption.
-        "-Wl,-Bsymbolic",
-    ],
-
     local_include_dirs: [ "Vulkan" ],
 
     generated_headers: [ "commit_header" ],
@@ -139,6 +133,17 @@ cc_defaults {
         host: {
             version_script: "Vulkan/android_host_vk_swiftshader.lds",
         },
+        linux: {
+            ldflags: [
+                // -Bsymbolic binds symbol references to their global definitions within
+                // a shared object, thereby preventing symbol preemption.
+                "-Wl,-Bsymbolic",
+            ],
+        },
+        darwin: {
+            ldflags: [
+            ],
+        }
     },
 }
 
diff --git a/src/commit_id.py b/src/commit_id.py
index ddd2f16a6..dafe0af9f 100755
--- a/src/commit_id.py
+++ b/src/commit_id.py
@@ -1,4 +1,4 @@
