From 0aef422f5e97062f6c4dcfd85c6744bb323a2e0e Mon Sep 17 00:00:00 2001
From: Tom Care <tcare@meta.com>
Date: Fri, 11 Jul 2025 14:51:00 -0700
Subject: [PATCH 1/2] Swiftshader darwin fixes

Summary: Use the per-platform include in llvm dependency, enable on darwin.

Test Plan: m libLLVM16_swiftshader

Rollback Plan:

Reviewers: achong, olja, benthomas

Reviewed By: achong

Subscribers: ryanyu

Differential Revision: https://phabricator.intern.facebook.com/D78192203
---
 Android.bp                       |  4 ++--
 third_party/llvm-16.0/Android.bp | 13 ++++++++++++-
 2 files changed, 14 insertions(+), 3 deletions(-)

diff --git a/Android.bp b/Android.bp
index 99be59483..3045b4f40 100644
--- a/Android.bp
+++ b/Android.bp
@@ -93,9 +93,9 @@ cc_defaults {
             compile_multilib: "64",
         },
 
-        // We don't need Darwin host-side builds
+        // Enable Darwin host-side builds for Mac ARM64 porting
         darwin: {
-            enabled: false,
+            enabled: true,
         },
     },
 }
diff --git a/third_party/llvm-16.0/Android.bp b/third_party/llvm-16.0/Android.bp
index 35ab101f5..61a0d3b61 100644
--- a/third_party/llvm-16.0/Android.bp
+++ b/third_party/llvm-16.0/Android.bp
@@ -1513,7 +1513,6 @@ cc_defaults {
     export_include_dirs: [
         "llvm/include",
         "configs/common/include",
-        "configs/android/include",
     ],
 
     cflags: [
@@ -1536,6 +1535,18 @@ cc_defaults {
         // b/193198227
         hwaddress: false,
     },
+    target: {
+        android: {
+            export_include_dirs: [
+                "configs/android/include",
+            ],
+        },
+        darwin: {
+            export_include_dirs: [
+                "configs/darwin/include",
+            ],
+        },
+    }
 }
 
 cc_library_static {
