+    VERBOSE_LOG("[DEBUG] PopulateVulkanAvailabilityImpl: Enumerating physical devices...");
     const auto physicalDevices = VK_EXPECT_RV(vk.instance().enumeratePhysicalDevices());
-    for (const auto& physicalDevice : physicalDevices) {
+    VERBOSE_LOG("[DEBUG] PopulateVulkanAvailabilityImpl: Found " << physicalDevices.size() << " physical devices");
+    
+    for (size_t i = 0; i < physicalDevices.size(); i++) {
+        const auto& physicalDevice = physicalDevices[i];
+        VERBOSE_LOG("[DEBUG] PopulateVulkanAvailabilityImpl: Processing device " << i);
+        
         auto* outPhysicalDevice = vulkanAvailability->add_physical_devices();
+        VERBOSE_LOG("[DEBUG] PopulateVulkanAvailabilityImpl: Added physical device to proto");
 
+        VERBOSE_LOG("[DEBUG] PopulateVulkanAvailabilityImpl: Getting device properties...");
         const auto props = physicalDevice.getProperties();
+        VERBOSE_LOG("[DEBUG] PopulateVulkanAvailabilityImpl: Got device properties: " << props.deviceName);
+        
         outPhysicalDevice->set_name(std::string(props.deviceName));
         outPhysicalDevice->set_type(
             props.deviceType == vkhpp::PhysicalDeviceType::eDiscreteGpu ?
                 ::gfxstream::proto::VulkanPhysicalDevice::TYPE_DISCRETE_GPU :
                 ::gfxstream::proto::VulkanPhysicalDevice::TYPE_OTHER);
+        VERBOSE_LOG("[DEBUG] PopulateVulkanAvailabilityImpl: Set device name and type");
 
+        VERBOSE_LOG("[DEBUG] PopulateVulkanAvailabilityImpl: Enumerating device extensions...");
         const auto exts = VK_EXPECT_RV(physicalDevice.enumerateDeviceExtensionProperties());
+        VERBOSE_LOG("[DEBUG] PopulateVulkanAvailabilityImpl: Found " << exts.size() << " extensions");
+        
         for (const auto& ext : exts) {
             outPhysicalDevice->add_extensions(std::string(ext.extensionName));
         }
+        VERBOSE_LOG("[DEBUG] PopulateVulkanAvailabilityImpl: Added all extensions for device " << i);
