 namespace {
 
+// Signal handler to catch crashes and print stack trace
+void crash_handler_vulkan_main(int sig) {
+    if (g_verbose_logging) {
+        std::cerr << "[CRASH] Signal " << sig << " caught in main Vulkan detection!" << std::endl;
+        std::cerr << "[CRASH] Stack trace:" << std::endl;
+        
+        void *array[10];
+        size_t size = backtrace(array, 10);
+        char **strings = backtrace_symbols(array, size);
+        
+        for (size_t i = 0; i < size; i++) {
+            std::cerr << "[CRASH] " << strings[i] << std::endl;
+        }
+        
+        free(strings);
+        std::cerr << "[CRASH] End of stack trace" << std::endl;
+    }
+    _exit(1);
+}
